@prefix : <https://w3id.org/bmp#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/bmp#> .

<http://w3id.org/bmp#> rdf:type owl:Ontology ;
                        <http://purl.org/dc/terms/contributor> <https://orcid.org/0000-0002-8651-0671> ;
                        <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0002-9383-7234> ;
                        <http://purl.org/dc/terms/description> """The Building Material Performance ontology is created to enrich 
building information models with highly aggregated information with respect to material information modelling and material simulation.

BMP classifies construction materials based on categories, types and property groups. Each property group describes parameters to be used as input values for simulation works."""@en ;
                        <http://purl.org/dc/terms/title> "Building Material Performance"@en ;
                        <http://purl.org/vocab/vann/preferredNamespacePrefix> "bmp"@en ;
                        <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/bmp#"@en ;
                        rdfs:label "Building Material Performance" ;
                        owl:versionInfo "1.0"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/contributor
<http://purl.org/dc/terms/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/name
<http://xmlns.com/foaf/0.1/name> rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/weblog
<http://xmlns.com/foaf/0.1/weblog> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://qudt.org/schema/qudt/Unit
<http://qudt.org/schema/qudt/Unit> rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/bmp#adjacentLayer
:adjacentLayer rdf:type owl:ObjectProperty ;
               rdfs:domain :Layer ;
               rdfs:range :Layer .


###  https://w3id.org/bmp#hasAdsorptionC
:hasAdsorptionC rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasWaterVapourSorptionIsotherm ;
                rdfs:domain :WaterVapourSorptionIsotherm ;
                rdfs:range :AdsorptionC .


###  https://w3id.org/bmp#hasAdsorptionK
:hasAdsorptionK rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasWaterVapourSorptionIsotherm ;
                rdfs:domain :WaterVapourSorptionIsotherm ;
                rdfs:range :AdsorptionK .


###  https://w3id.org/bmp#hasAdsorptionWm
:hasAdsorptionWm rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :hasWaterVapourSorptionIsotherm ;
                 rdfs:domain :WaterVapourSorptionIsotherm ;
                 rdfs:range :AdsorptionWm .


###  https://w3id.org/bmp#hasBrickType
:hasBrickType rdf:type owl:ObjectProperty ;
              rdfs:domain :Brick ;
              rdfs:range :BrickMasonryUnit ,
                         :CalciumSilicateUnit ,
                         :ClayUnit .


###  https://w3id.org/bmp#hasBulkDensity
:hasBulkDensity rdf:type owl:ObjectProperty ;
                rdfs:domain :Physical ;
                rdfs:range :BulkDensity .


###  https://w3id.org/bmp#hasConcreteType
:hasConcreteType rdf:type owl:ObjectProperty ;
                 rdfs:domain :Concrete ;
                 rdfs:range :HeavyWeightAggregate ,
                            :HeavyWeightConcrete ,
                            :LightWeightAggregate ,
                            :LightWeightConcrete ,
                            :PrestressedConcrete ,
                            :ReinforcedConcrete .


###  https://w3id.org/bmp#hasDesorptionC
:hasDesorptionC rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasWaterVapourSorptionIsotherm ;
                rdfs:domain :WaterVapourSorptionIsotherm ;
                rdfs:range :DesorptionC .


###  https://w3id.org/bmp#hasDesorptionK
:hasDesorptionK rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasWaterVapourSorptionIsotherm ;
                rdfs:domain :WaterVapourSorptionIsotherm ;
                rdfs:range :DesorptionK .


###  https://w3id.org/bmp#hasDesorptionWm
:hasDesorptionWm rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf :hasWaterVapourSorptionIsotherm ;
                 rdfs:domain :WaterVapourSorptionIsotherm ;
                 rdfs:range :DesorptionWm .


###  https://w3id.org/bmp#hasDropping
:hasDropping rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf :hasFireResistance ;
             rdfs:domain :FireResistance ;
             rdfs:range :Dropping .


###  https://w3id.org/bmp#hasEffectiveGasPermeability
:hasEffectiveGasPermeability rdf:type owl:ObjectProperty ;
                             rdfs:domain :Physical ;
                             rdfs:range :EffectiveGasPermeability .


###  https://w3id.org/bmp#hasFireClassification
:hasFireClassification rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf :hasFireResistance ;
                       rdfs:domain :FireResistance ;
                       rdfs:range :FireClassification .


###  https://w3id.org/bmp#hasFireResistance
:hasFireResistance rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf owl:topObjectProperty ;
                   rdfs:domain :Durability ;
                   rdfs:range :FireResistance .


###  https://w3id.org/bmp#hasGlassType
:hasGlassType rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf owl:topObjectProperty ;
              rdfs:domain :Glass ;
              rdfs:range :DrawnSheetGlass ,
                         :ESG ,
                         :FloatGlass ,
                         :VSG .


###  https://w3id.org/bmp#hasHempType
:hasHempType rdf:type owl:ObjectProperty ;
             rdfs:domain :Hemp ;
             rdfs:range :HempFibre ,
                        :Hempcrete .


###  https://w3id.org/bmp#hasInnerLayer
:hasInnerLayer rdf:type owl:ObjectProperty ;
               rdfs:domain :LayerSet ;
               rdfs:range :Layer .


###  https://w3id.org/bmp#hasLayer
:hasLayer rdf:type owl:ObjectProperty ;
          rdfs:domain :LayerSet ;
          rdfs:range :Layer .


###  https://w3id.org/bmp#hasLayerFunction
:hasLayerFunction rdf:type owl:ObjectProperty ;
                  rdfs:domain :Layer ;
                  rdfs:range :LayerFunction .


###  https://w3id.org/bmp#hasLifeSpan
:hasLifeSpan rdf:type owl:ObjectProperty ;
             rdfs:domain :Durability ;
             rdfs:range :LifeSpan .


###  https://w3id.org/bmp#hasLiquidTransportCoef
:hasLiquidTransportCoef rdf:type owl:ObjectProperty ;
                        rdfs:domain :Hygric ;
                        rdfs:range :LiquidTransportCoef .


###  https://w3id.org/bmp#hasMaterialCategory
:hasMaterialCategory rdf:type owl:ObjectProperty ;
                     rdfs:domain :Material ;
                     rdfs:range :MaterialCategory .


###  https://w3id.org/bmp#hasMaterialProperty
:hasMaterialProperty rdf:type owl:ObjectProperty ;
                     rdfs:domain :Material ;
                     rdfs:range :MaterialProperty .


###  https://w3id.org/bmp#hasMaterialType
:hasMaterialType rdf:type owl:ObjectProperty ;
                 rdfs:domain :Material ;
                 rdfs:range :MaterialType .


###  https://w3id.org/bmp#hasMineralFibreType
:hasMineralFibreType rdf:type owl:ObjectProperty ;
                     rdfs:domain :MineralFibre ;
                     rdfs:range :GlassFibres ,
                                :Rockwool ,
                                :Slagwool .


###  https://w3id.org/bmp#hasMoistureContent
:hasMoistureContent rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :hasThermalConductivity ;
                    rdfs:domain :ThermalConductivity ;
                    rdfs:range :MoistureContent .


###  https://w3id.org/bmp#hasNaturalStoneType
:hasNaturalStoneType rdf:type owl:ObjectProperty ;
                     rdfs:domain :NaturalStone ;
                     rdfs:range :BasaltStone ,
                                :GranitStone ,
                                :SandStone .


###  https://w3id.org/bmp#hasOuterLayer
:hasOuterLayer rdf:type owl:ObjectProperty ;
               rdfs:domain :LayerSet ;
               rdfs:range :Layer .


###  https://w3id.org/bmp#hasPolymerType
:hasPolymerType rdf:type owl:ObjectProperty ;
                rdfs:domain :Polymer ;
                rdfs:range :ExpandedPolystyrene ,
                           :ExtrudedPolystyrene .


###  https://w3id.org/bmp#hasPorosity
:hasPorosity rdf:type owl:ObjectProperty ;
             rdfs:domain :Physical ;
             rdfs:range :Porosity .


###  https://w3id.org/bmp#hasRcValue
:hasRcValue rdf:type owl:ObjectProperty ;
            rdfs:domain :Layer ,
                        :LayerSet ;
            rdfs:range [ rdf:type owl:Restriction ;
                         owl:onProperty :hasUnit ;
                         owl:someValuesFrom <http://qudt.org/schema/qudt/Unit>
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasValue ;
                         owl:someValuesFrom xsd:float
                       ] .


###  https://w3id.org/bmp#hasRelativeGasDiffusivity
:hasRelativeGasDiffusivity rdf:type owl:ObjectProperty ;
                           rdfs:domain :Physical ;
                           rdfs:range :RelativeGasDiffusivity .


###  https://w3id.org/bmp#hasSmokeDevelopment
:hasSmokeDevelopment rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf :hasFireResistance ;
                     rdfs:domain :FireResistance ;
                     rdfs:range :SmokeDevelopment .


###  https://w3id.org/bmp#hasSolarTransmittance
:hasSolarTransmittance rdf:type owl:ObjectProperty ;
                       rdfs:domain :Thermal ;
                       rdfs:range :SolarTransmittance .


###  https://w3id.org/bmp#hasSpecificHeatCapacity
:hasSpecificHeatCapacity rdf:type owl:ObjectProperty ;
                         rdfs:domain :Thermal ;
                         rdfs:range :SpecificHeatCapacity .


###  https://w3id.org/bmp#hasTemperatureCondition
:hasTemperatureCondition rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf :hasThermalConductivity ;
                         rdfs:domain :ThermalConductivity ;
                         rdfs:range :TempCondition .


###  https://w3id.org/bmp#hasThermalConductivity
:hasThermalConductivity rdf:type owl:ObjectProperty ;
                        rdfs:domain :Thermal ;
                        rdfs:range :ThermalConductivity .


###  https://w3id.org/bmp#hasThermalDiffusivity
:hasThermalDiffusivity rdf:type owl:ObjectProperty ;
                       rdfs:domain :Thermal ;
                       rdfs:range :ThermalDiffusivity .


###  https://w3id.org/bmp#hasThermalExpansionCoef
:hasThermalExpansionCoef rdf:type owl:ObjectProperty ;
                         rdfs:domain :Thermal ;
                         rdfs:range :ThermalExpansionCoef .


###  https://w3id.org/bmp#hasThickness
:hasThickness rdf:type owl:ObjectProperty ;
              rdfs:domain :Layer ,
                          :LayerSet ;
              rdfs:range [ rdf:type owl:Restriction ;
                           owl:onProperty :hasUnit ;
                           owl:someValuesFrom <http://qudt.org/schema/qudt/Unit>
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasValue ;
                           owl:someValuesFrom xsd:float
                         ] .


###  https://w3id.org/bmp#hasUValue
:hasUValue rdf:type owl:ObjectProperty ;
           rdfs:domain :Layer ,
                       :LayerSet ;
           rdfs:range [ rdf:type owl:Restriction ;
                        owl:onProperty :hasUnit ;
                        owl:someValuesFrom <http://qudt.org/schema/qudt/Unit>
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasValue ;
                        owl:someValuesFrom xsd:float
                      ] .


###  https://w3id.org/bmp#hasVolumetricHeatCapacity
:hasVolumetricHeatCapacity rdf:type owl:ObjectProperty ;
                           rdfs:domain :Thermal ;
                           rdfs:range :VolumetricHeatCapacity .


###  https://w3id.org/bmp#hasWaterVapourDiffusionThickness
:hasWaterVapourDiffusionThickness rdf:type owl:ObjectProperty ;
                                  rdfs:domain :Hygric ;
                                  rdfs:range :WaterVapourDiffusionThickness .


###  https://w3id.org/bmp#hasWaterVapourDiffusivity
:hasWaterVapourDiffusivity rdf:type owl:ObjectProperty ;
                           rdfs:domain :Hygric ;
                           rdfs:range :WaterVapourDiffusivity .


###  https://w3id.org/bmp#hasWaterVapourPermeability
:hasWaterVapourPermeability rdf:type owl:ObjectProperty ;
                            rdfs:domain :Hygric ;
                            rdfs:range :WaterVapourPermeability .


###  https://w3id.org/bmp#hasWaterVapourResistanceFactor
:hasWaterVapourResistanceFactor rdf:type owl:ObjectProperty ;
                                rdfs:domain :Hygric ;
                                rdfs:range :WaterVapourResistanceFactor .


###  https://w3id.org/bmp#hasWaterVapourSorptionIsotherm
:hasWaterVapourSorptionIsotherm rdf:type owl:ObjectProperty ;
                                rdfs:domain :Hygric ;
                                rdfs:range :WaterVapourSorptionIsotherm .


###  https://w3id.org/bmp#hasWoodType
:hasWoodType rdf:type owl:ObjectProperty ;
             rdfs:domain :WoodTimber ;
             rdfs:range :AirDryTimber ,
                        :WoodHard ,
                        :WoodSoft .


###  https://w3id.org/bmp#isBrick
:isBrick rdf:type owl:ObjectProperty ,
                  owl:TransitiveProperty ;
         rdfs:domain :MaterialCategory ;
         rdfs:range :Brick .


###  https://w3id.org/bmp#isConcrete
:isConcrete rdf:type owl:ObjectProperty ;
            rdfs:domain :MaterialCategory ;
            rdfs:range :Concrete .


###  https://w3id.org/bmp#isGlass
:isGlass rdf:type owl:ObjectProperty ,
                  owl:TransitiveProperty ;
         rdfs:domain :MaterialCategory ;
         rdfs:range :Glass .


###  https://w3id.org/bmp#isHemp
:isHemp rdf:type owl:ObjectProperty ,
                 owl:TransitiveProperty ;
        rdfs:domain :MaterialCategory ;
        rdfs:range :Hemp .


###  https://w3id.org/bmp#isMineralFibre
:isMineralFibre rdf:type owl:ObjectProperty ;
                rdfs:domain :MaterialCategory ;
                rdfs:range :MineralFibre .


###  https://w3id.org/bmp#isNaturalStone
:isNaturalStone rdf:type owl:ObjectProperty ;
                rdfs:domain :MaterialCategory ;
                rdfs:range :NaturalStone .


###  https://w3id.org/bmp#isPolymer
:isPolymer rdf:type owl:ObjectProperty ;
           rdfs:domain :MaterialCategory ;
           rdfs:range :Polymer .


###  https://w3id.org/bmp#isWoodTimber
:isWoodTimber rdf:type owl:ObjectProperty ;
              rdfs:domain :MaterialCategory ;
              rdfs:range :WoodTimber .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/bmp#hasUnit
:hasUnit rdf:type owl:DatatypeProperty .


###  https://w3id.org/bmp#hasValue
:hasValue rdf:type owl:DatatypeProperty ;
          rdfs:domain :LayerProperty ,
                      :MaterialProperty .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/bmp#Accoustic
:Accoustic rdf:type owl:Class ;
           rdfs:subClassOf :MaterialProperty ;
           owl:disjointWith :Durability ,
                            :Hygric ,
                            :Mechanical ,
                            :Optical ,
                            :Physical ,
                            :Thermal ;
           rdfs:label "Accoustic"@en .


###  https://w3id.org/bmp#AdsorptionC
:AdsorptionC rdf:type owl:Class ;
             rdfs:subClassOf :WaterVapourSorptionIsotherm .


###  https://w3id.org/bmp#AdsorptionK
:AdsorptionK rdf:type owl:Class ;
             rdfs:subClassOf :WaterVapourSorptionIsotherm .


###  https://w3id.org/bmp#AdsorptionWm
:AdsorptionWm rdf:type owl:Class ;
              rdfs:subClassOf :WaterVapourSorptionIsotherm .


###  https://w3id.org/bmp#AirDryTimber
:AirDryTimber rdf:type owl:Class ;
              rdfs:subClassOf :MaterialType ;
              rdfs:comment "https://www.iso.org/standard/77077.html"@en ,
                           "Material Category: Wood / TimberWhat it is made of / How it's made: It is made of natural wood logs (like oak, pine, or spruce) composed of cellulose fibers and lignin. It is produced by stacking freshly cut lumber outdoors under a roof for months or years, allowing the natural wind and air circulation to evaporate the moisture level down to a stable $12\\text{--}15\\%$ without using artificial kiln heat.Description: Natural wood lumber that has been seasoned by outdoor air circulation to reduce moisture and prevent warping (AirDryTimber)." ;
              rdfs:label "AirDryTimber"@en .


###  https://w3id.org/bmp#BasaltStone
:BasaltStone rdf:type owl:Class ;
             rdfs:subClassOf :MaterialType ;
             rdfs:comment "https://www.iso.org/standard/77077.html"@en ,
                          """Material Category: Natural Stone (Igneous Rock)
What it is made of / How it's made: It is made of dense, dark minerals rich in iron and magnesium (like pyroxene and plagioclase). It is formed when molten volcanic lava erupts onto the Earth's surface or ocean floor and cools very rapidly, leaving no time for large crystals to grow.
Description: A heavy, dark, and exceptionally hard volcanic rock with a very fine-grained texture (BasaltStone).""" ;
             rdfs:label "BasaltStone"@en .


###  https://w3id.org/bmp#Brick
:Brick rdf:type owl:Class ;
       rdfs:subClassOf :MaterialCategory ;
       rdfs:comment "https://www.iso.org/standard/32918.html"@en ;
       rdfs:label "Brick"@en .


###  https://w3id.org/bmp#BrickMasonryUnit
:BrickMasonryUnit rdf:type owl:Class ;
                  rdfs:subClassOf :MaterialType ;
                  rdfs:comment "https://www.iso.org/standard/32918.html"@en ,
                               """Material Category: Brick / Ceramics
What it is made of / How it's made: It is made from natural surface clay, shale, or refined earthen minerals mixed with water. It is pressed or extruded into a rectangular block shape and then dried and baked in a high-temperature kiln until the minerals chemically fuse into a vitrified, rock-hard structure.
Description: A standard, kiln-fired rectangular building block used for laying structural or facing brickwork (BrickMasonryUnit).""" ;
                  rdfs:label "BrickMasonryUnit"@en .


###  https://w3id.org/bmp#BulkDensity
:BulkDensity rdf:type owl:Class ;
             rdfs:subClassOf :Physical .


###  https://w3id.org/bmp#CalciumSilicateUnit
:CalciumSilicateUnit rdf:type owl:Class ;
                     rdfs:subClassOf :MaterialType ;
                     rdfs:comment "https://www.iso.org/standard/32918.html"@en ,
                                  """Material Category: Brick / Masonry
What it is made of / How it's made: It is made from a precise mixture of lime (calcium oxide), quartz sand, and water. Instead of being fired in a kiln like clay bricks, these units are compressed heavily into molds and then cured inside a pressurized steam chamber (an autoclave) to trigger a chemical bonding process.
Description: A durable, highly uniform, sand-lime building block cured using high-pressure steam (CalciumSilicateUnit).""" ;
                     rdfs:label "CalciumSilicateUnit"@en .


###  https://w3id.org/bmp#ClayUnit
:ClayUnit rdf:type owl:Class ;
          rdfs:subClassOf :MaterialType ;
          rdfs:comment "https://www.iso.org/standard/32918.html"@en ,
                       "Material Category: Brick / CeramicsWhat it is made of / How it's made: It is made strictly from natural kiln-firing clays and silicates. It is molded and baked at temperatures exceeding 1000 degree C, which gives it its characteristic terracotta-red or brown color and excellent weather resistance.Description: A traditional building block or tile manufactured exclusively from fired natural clay (ClayUnit)." ;
          rdfs:label "ClayUnit"@en .


###  https://w3id.org/bmp#Concrete
:Concrete rdf:type owl:Class ;
          rdfs:subClassOf :MaterialCategory ;
          rdfs:comment "https://www.iso.org/standard/41260.html"@en ;
          rdfs:label "Concrete"@en .


###  https://w3id.org/bmp#DesorptionC
:DesorptionC rdf:type owl:Class ;
             rdfs:subClassOf :WaterVapourSorptionIsotherm .


###  https://w3id.org/bmp#DesorptionK
:DesorptionK rdf:type owl:Class ;
             rdfs:subClassOf :WaterVapourSorptionIsotherm .


###  https://w3id.org/bmp#DesorptionWm
:DesorptionWm rdf:type owl:Class ;
              rdfs:subClassOf :WaterVapourSorptionIsotherm .


###  https://w3id.org/bmp#DrawnSheetGlass
:DrawnSheetGlass rdf:type owl:Class ;
                 rdfs:subClassOf :MaterialType ;
                 rdfs:comment "https://www.iso.org/standard/46375.html"@en ,
                              """Material Category: Glass
What it is made of / How it's made: It is made of melted silica sand, soda ash, and limestone. It is produced by a classic industrial method where the molten glass is physically pulled vertically upward out of the furnace by rollers, cooling in the air as a continuous sheet before being cut.
Description: Flat glass produced by drawing a molten ribbon vertically, known for having a slight, wave-like optical distortion (DrawnSheetGlass).""" ;
                 rdfs:label "DrawnSheetGlass"@en .


###  https://w3id.org/bmp#Dropping
:Dropping rdf:type owl:Class ;
          rdfs:subClassOf :FireResistance ;
          rdfs:label "Dropping"@en .


###  https://w3id.org/bmp#Durability
:Durability rdf:type owl:Class ;
            rdfs:subClassOf :MaterialProperty ;
            owl:disjointWith :Hygric ,
                             :Mechanical ,
                             :Optical ,
                             :Physical ,
                             :Thermal ;
            rdfs:label "Durability"@en .


###  https://w3id.org/bmp#ESG
:ESG rdf:type owl:Class ;
     rdfs:subClassOf :MaterialType ;
     rdfs:comment "Material Category: Glass / Toughened Safety GlassWhat it is made of / How it's made: It is made from a standard sheet of float glass (silica sand, soda ash, and limestone) that undergoes a thermal tempering process. The glass is heated up to an intense temperature of around $600^\\circ\\text{C}$ and then blasted uniformly with cold air. This rapid cooling locks the outside layers in a state of high compression while the inside remains under high tension, drastically increasing its strength.Description: A single pane of highly toughened safety glass designed to withstand heavy impacts and break into thousands of tiny, blunt, relatively harmless pebbles instead of sharp shards (ESG)." .


###  https://w3id.org/bmp#EffectiveGasPermeability
:EffectiveGasPermeability rdf:type owl:Class ;
                          rdfs:subClassOf :Physical .


###  https://w3id.org/bmp#ExpandedPolystyrene
:ExpandedPolystyrene rdf:type owl:Class ;
                     rdfs:subClassOf :MaterialType ;
                     rdfs:comment """Material Category: Polymer / Plastic Foam
What it is made of / How it's made: It is made from raw polystyrene plastic beads containing a pocketed gas blowing agent. The beads are placed in a mold and hit with hot steam, causing them to puff up drastically, multiply in size, and press together to fuse into a lightweight white foam block.
Description: The classic white, beaded insulation foam made by expanding plastic spheres with steam (ExpandedPolystyrene).""" .


###  https://w3id.org/bmp#ExtrudedPolystyrene
:ExtrudedPolystyrene rdf:type owl:Class ;
                     rdfs:subClassOf :MaterialType ;
                     rdfs:comment """Material Category: Polymer / Plastic Foam
What it is made of / How it's made: It is made from the exact same polystyrene plastic resin, but it is melted together with a gas and continuously forced (extruded) through a straight shaping die. This completely eliminates any gaps between beads, creating a smooth, solid, closed-cell foam board.
Description: High-density, rigid insulation boards with a completely waterproof, closed-cell structure (ExtrudedPolystyrene).""" .


###  https://w3id.org/bmp#FireClassification
:FireClassification rdf:type owl:Class ;
                    rdfs:subClassOf :FireResistance ;
                    rdfs:label "FireClassification"@en .


###  https://w3id.org/bmp#FireResistance
:FireResistance rdf:type owl:Class ;
                rdfs:subClassOf :Durability ;
                rdfs:comment "https://www.peroni.com/lang_UK/_download/EN_Reaction_to_Fire_Classification.pdf"@en ;
                rdfs:label "FireResistance"@en .


###  https://w3id.org/bmp#FloatGlass
:FloatGlass rdf:type owl:Class ;
            rdfs:subClassOf :MaterialType ;
            rdfs:comment "https://www.iso.org/standard/46375.html"@en ,
                         """Material Category: Glass
What it is made of / How it's made: It is made of silica sand, soda ash, dolomite, and limestone. It is produced by pouring the liquid glass mixture out of a furnace directly onto a bath of molten liquid tin, where it floats, spreads out, and cools into a perfectly flat, uniform sheet.
Description: Standard modern window glass manufactured by floating liquid glass over a smooth bed of molten tin (FloatGlass).""" ;
            rdfs:label "FloatGlass"@en .


###  https://w3id.org/bmp#Glass
:Glass rdf:type owl:Class ;
       rdfs:subClassOf :MaterialCategory ;
       rdfs:comment "https://www.iso.org/standard/46375.html"@en ,
                    "Glass materials are rigid, non-crystalline solids used extensively for windows, facades, and partitions. The category features basic manufactured flat glass (float glass), toughened single-pane safety glass (ESG), and shatterproof laminated safety glass (VSG). In multi-pane window systems, the airtight gaps between these glass layers are frequently injected with dense, invisible gases like argon to drastically improve the building's energy efficiency." ;
       rdfs:label "Glass"@en .


###  https://w3id.org/bmp#GlassFibres
:GlassFibres rdf:type owl:Class ;
             rdfs:subClassOf :MaterialType ;
             rdfs:comment """Material Category: Mineral Fibre
What it is made of / How it's made: It is made from silica sand and recycled glass materials. The ingredients are melted in a furnace at extreme temperatures and then forced through microscopic holes while being blasted with air, spinning them into highly flexible glass threads.
Description: Fine, spun filaments of glass gathered into fluffy thermal insulation mats or structural reinforcement meshes (GlassFibres).""" .


###  https://w3id.org/bmp#GranitStone
:GranitStone rdf:type owl:Class ;
             rdfs:subClassOf :MaterialType ;
             rdfs:comment "https://www.iso.org/standard/77077.html"@en ,
                          """Material Category: Natural Stone (Igneous Rock)
What it is made of / How it's made: It is made of crystalline minerals like quartz, feldspar, and mica. It is formed deep underground where molten magma gets trapped and cools incredibly slowly over millions of years, allowing large, visible mineral crystals to develop.
Description: A hard, heavy, and coarse-grained igneous rock with a distinctly speckled multi-colored appearance (GranitStone).""" ;
             rdfs:label "GranitStone"@en .


###  https://w3id.org/bmp#HeavyWeightAggregate
:HeavyWeightAggregate rdf:type owl:Class ;
                      rdfs:subClassOf :MaterialType ;
                      rdfs:comment "https://www.iso.org/standard/41260.html"@en ,
                                   """Material Category: Concrete Component
What it is made of / How it's made: It is made from crushing exceptionally dense natural minerals or industrial materials like magnetite, barite, hematite, or iron shot. These dense stones are washed and graded by size to be used specifically as the coarse filler material inside heavy concrete mixes.
Description: High-density stone or metal fragments used as raw aggregate filler to produce maximum-density concrete (HeavyWeightAggregate).""" ;
                      rdfs:label "HeavyWeightAggregate"@en .


###  https://w3id.org/bmp#HeavyWeightConcrete
:HeavyWeightConcrete rdf:type owl:Class ;
                     rdfs:subClassOf :MaterialType ;
                     rdfs:comment "https://www.iso.org/standard/41260.html"@en ,
                                  """Material Category: Concrete
What it is made of / How it's made: It is made by mixing standard cement, water, sand, and heavy-density stone aggregate fillers (like barite or magnetite). The resulting mix is incredibly dense and massive compared to regular structural concrete.
Description: A specialized, high-density concrete mix designed primarily for radiation shielding and massive gravity counterweights (HeavyWeightConcrete).""" ;
                     rdfs:label "HeavyWeightConcrete"@en .


###  https://w3id.org/bmp#Hemp
:Hemp rdf:type owl:Class ;
      rdfs:subClassOf :MaterialCategory ;
      rdfs:comment "https://www.iso.org/standard/78231.html"@en ;
      rdfs:label "Hemp"@en .


###  https://w3id.org/bmp#HempFibre
:HempFibre rdf:type owl:Class ;
           rdfs:subClassOf :MaterialType ;
           rdfs:comment "https://www.iso.org/standard/78231.html"@en ,
                        """Material Category: Hemp / Natural Plant Fiber
What it is made of / How it's made: It is made from the long, tough outer skin of the industrial hemp plant stalk. These outer strands are separated from the woody core through mechanical stripping, cleaned, and combed out into strong textile-like plant threads.
Description: Raw, high-tensile plant fibers woven into flexible acoustic insulation batts or structural reinforcing mats (HempFibre).""" ;
           rdfs:label "HempFibre"@en .


###  https://w3id.org/bmp#Hempcrete
:Hempcrete rdf:type owl:Class ;
           rdfs:subClassOf :MaterialType ;
           rdfs:comment "https://www.iso.org/standard/41260.html"@en ,
                        "https://www.iso.org/standard/78231.html"@en ,
                        """Material Category: Hemp / Bio-composite
What it is made of / How it's made: It is made by mixing the chopped, woody inner core of the industrial hemp plant (called hurds) with a binder made of slaked lime and water. The lime undergoes a chemical reaction with the air, turning back into stone and trapping the hemp fibers inside.
Description: A sustainable, breathable, and carbon-negative building insulation material made of hemp hurds and lime (Hempcrete).""" ;
           rdfs:label "Hempcrete"@en .


