#################################################################
#    Datatypes
#################################################################

###  http://qudt.org/schema/qudt/Unit
<http://qudt.org/schema/qudt/Unit> rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/at#constructionPeriod
at:constructionPeriod rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf owl:topObjectProperty ;
                      rdfs:domain at:Building ;
                      rdfs:range at:ConstructionPeriod .


###  https://w3id.org/at#hasBuildingArchetype
at:hasBuildingArchetype rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf owl:topObjectProperty ;
                        rdfs:domain at:Building ;
                        rdfs:range at:BuildingArchetype .


###  https://w3id.org/at#hasBuildingElement
at:hasBuildingElement rdf:type owl:ObjectProperty ;
                      rdfs:domain at:Building ;
                      rdfs:range at:BuildingElement .


###  https://w3id.org/at#hasBuildingType
at:hasBuildingType rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf owl:topObjectProperty ;
                   rdfs:domain at:Building ;
                   rdfs:range at:BuildingType .


###  https://w3id.org/at#hasElementArchetype
at:hasElementArchetype rdf:type owl:ObjectProperty ;
                       rdfs:domain at:BuildingElement ;
                       rdfs:range at:ElementArchetype .


###  https://w3id.org/at#hasLayer
at:hasLayer rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf owl:topObjectProperty ;
            rdfs:domain at:LayerSet ;
            rdfs:range at:Layer .


###  https://w3id.org/at#hasLayerDirect
at:hasLayerDirect rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf owl:topObjectProperty ;
                  rdfs:domain at:BuildingElement ;
                  owl:propertyChainAxiom ( at:hasLayerSet
                                           at:hasLayer
                                         ) .


###  https://w3id.org/at#hasLayerSet
at:hasLayerSet rdf:type owl:ObjectProperty ;
               rdfs:domain at:BuildingElement ;
               rdfs:range at:LayerSet .


###  https://w3id.org/at#hasMaterial
at:hasMaterial rdf:type owl:ObjectProperty ;
               rdfs:domain at:Layer ;
               rdfs:range at:Material .


###  https://w3id.org/at#hasReferenceLayerSet
at:hasReferenceLayerSet rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf owl:topObjectProperty ;
                        rdfs:domain at:LayerSet ;
                        rdfs:range at:ReferenceLayerSet .


###  https://w3id.org/at#hasReferenceMaterial
at:hasReferenceMaterial rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf owl:topObjectProperty ;
                        rdfs:domain at:Material ;
                        rdfs:range at:ReferenceMaterial .


###  https://w3id.org/at#hasRenovationStatus
at:hasRenovationStatus rdf:type owl:ObjectProperty ;
                       rdfs:domain at:Building ;
                       rdfs:range at:RenovationStatus .


###  https://w3id.org/at#hasResidentialType
at:hasResidentialType rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf at:hasBuildingType ;
                      rdfs:domain at:Residential ;
                      rdfs:range at:ApartmentHouse ,
                                 at:DetachedHouse ,
                                 at:GalleryHouse ,
                                 at:MaisonetteHouse ,
                                 at:SemiDetachedHouse ,
                                 at:TerraceHouse .


###  https://w3id.org/at#isType
at:isType rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf owl:topObjectProperty ;
          rdfs:domain at:Building .


###  https://w3id.org/bmp#adjacentLayer
bmp:adjacentLayer rdf:type owl:ObjectProperty ;
                  rdfs:domain bmp:Layer ;
                  rdfs:range bmp:Layer .


###  https://w3id.org/bmp#hasAdsorptionC
bmp:hasAdsorptionC rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf bmp:hasWaterVapourSorptionIsotherm ;
                   rdfs:domain bmp:WaterVapourSorptionIsotherm ;
                   rdfs:range bmp:AdsorptionC .


###  https://w3id.org/bmp#hasAdsorptionK
bmp:hasAdsorptionK rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf bmp:hasWaterVapourSorptionIsotherm ;
                   rdfs:domain bmp:WaterVapourSorptionIsotherm ;
                   rdfs:range bmp:AdsorptionK .


###  https://w3id.org/bmp#hasAdsorptionWm
bmp:hasAdsorptionWm rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf bmp:hasWaterVapourSorptionIsotherm ;
                    rdfs:domain bmp:WaterVapourSorptionIsotherm ;
                    rdfs:range bmp:AdsorptionWm .


###  https://w3id.org/bmp#hasBulkDensity
bmp:hasBulkDensity rdf:type owl:ObjectProperty ;
                   rdfs:domain bmp:Physical ;
                   rdfs:range bmp:BulkDensity .


###  https://w3id.org/bmp#hasDesorptionC
bmp:hasDesorptionC rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf bmp:hasWaterVapourSorptionIsotherm ;
                   rdfs:domain bmp:WaterVapourSorptionIsotherm ;
                   rdfs:range bmp:DesorptionC .


###  https://w3id.org/bmp#hasDesorptionK
bmp:hasDesorptionK rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf bmp:hasWaterVapourSorptionIsotherm ;
                   rdfs:domain bmp:WaterVapourSorptionIsotherm ;
                   rdfs:range bmp:DesorptionK .


###  https://w3id.org/bmp#hasDesorptionWm
bmp:hasDesorptionWm rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf bmp:hasWaterVapourSorptionIsotherm ;
                    rdfs:domain bmp:WaterVapourSorptionIsotherm ;
                    rdfs:range bmp:DesorptionWm .


###  https://w3id.org/bmp#hasDropping
bmp:hasDropping rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf bmp:hasFireResistance ;
                rdfs:domain bmp:FireResistance ;
                rdfs:range bmp:Dropping .


###  https://w3id.org/bmp#hasEffectiveGasPermeability
bmp:hasEffectiveGasPermeability rdf:type owl:ObjectProperty ;
                                rdfs:domain bmp:Physical ;
                                rdfs:range bmp:EffectiveGasPermeability .


###  https://w3id.org/bmp#hasFireClassification
bmp:hasFireClassification rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf bmp:hasFireResistance ;
                          rdfs:domain bmp:FireResistance ;
                          rdfs:range bmp:FireClassification .


###  https://w3id.org/bmp#hasFireResistance
bmp:hasFireResistance rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf owl:topObjectProperty ;
                      rdfs:domain bmp:Durability ;
                      rdfs:range bmp:FireResistance .


###  https://w3id.org/bmp#hasInnerLayer
bmp:hasInnerLayer rdf:type owl:ObjectProperty ;
                  rdfs:domain bmp:LayerSet ;
                  rdfs:range bmp:Layer .


###  https://w3id.org/bmp#hasLayer
bmp:hasLayer rdf:type owl:ObjectProperty ;
             rdfs:domain bmp:LayerSet ;
             rdfs:range bmp:Layer .


###  https://w3id.org/bmp#hasLayerFunction
bmp:hasLayerFunction rdf:type owl:ObjectProperty ;
                     rdfs:domain bmp:Layer ;
                     rdfs:range bmp:LayerFunction .


###  https://w3id.org/bmp#hasLifeSpan
bmp:hasLifeSpan rdf:type owl:ObjectProperty ;
                rdfs:domain bmp:Durability ;
                rdfs:range bmp:LifeSpan .


###  https://w3id.org/bmp#hasLiquidTransportCoef
bmp:hasLiquidTransportCoef rdf:type owl:ObjectProperty ;
                           rdfs:domain bmp:Hygric ;
                           rdfs:range bmp:LiquidTransportCoef .


###  https://w3id.org/bmp#hasMaterialCategory
bmp:hasMaterialCategory rdf:type owl:ObjectProperty ;
                        rdfs:domain bmp:Material ;
                        rdfs:range bmp:Brick ,
                                   bmp:Concrete ,
                                   bmp:Glass ,
                                   bmp:Hemp ,
                                   bmp:MineralFibre ,
                                   bmp:NaturalStone ,
                                   bmp:Polymer ,
                                   bmp:WoodTimber .


###  https://w3id.org/bmp#hasMaterialProperty
bmp:hasMaterialProperty rdf:type owl:ObjectProperty ;
                        rdfs:domain bmp:Material ;
                        rdfs:range bmp:MaterialProperty .


###  https://w3id.org/bmp#hasMaterialType
bmp:hasMaterialType rdf:type owl:ObjectProperty ;
                    rdfs:domain bmp:Material ;
                    rdfs:range bmp:AirDryTimber ,
                               bmp:BasaltStone ,
                               bmp:BrickMasonryUnit ,
                               bmp:CalciumSilicateUnit ,
                               bmp:ClayUnit ,
                               bmp:DrawnSheetGlass ,
                               bmp:ESG ,
                               bmp:ExpandedPolystyrene ,
                               bmp:ExtrudedPolystyrene ,
                               bmp:FloatGlass ,
                               bmp:GlassFibres ,
                               bmp:GranitStone ,
                               bmp:HeavyWeightAggregate ,
                               bmp:HeavyWeightConcrete ,
                               bmp:HempFibre ,
                               bmp:Hempcrete ,
                               bmp:LightWeightAggregate ,
                               bmp:LightWeightConcrete ,
                               bmp:PrestressedConcrete ,
                               bmp:ReinforcedConcrete ,
                               bmp:Rockwool ,
                               bmp:SandStone ,
                               bmp:Slagwool ,
                               bmp:VSG ,
                               bmp:WoodHard ,
                               bmp:WoodSoft .


###  https://w3id.org/bmp#hasMoistureContent
bmp:hasMoistureContent rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf bmp:hasThermalConductivity ;
                       rdfs:domain bmp:ThermalConductivity ;
                       rdfs:range bmp:MoistureContent .


###  https://w3id.org/bmp#hasOuterLayer
bmp:hasOuterLayer rdf:type owl:ObjectProperty ;
                  rdfs:domain bmp:LayerSet ;
                  rdfs:range bmp:Layer .


###  https://w3id.org/bmp#hasPorosity
bmp:hasPorosity rdf:type owl:ObjectProperty ;
                rdfs:domain bmp:Physical ;
                rdfs:range bmp:Porosity .


###  https://w3id.org/bmp#hasRcValue
bmp:hasRcValue rdf:type owl:ObjectProperty ;
               rdfs:domain bmp:Layer ,
                           bmp:LayerSet ;
               rdfs:range [ rdf:type owl:Restriction ;
                            owl:onProperty bmp:hasUnit ;
                            owl:someValuesFrom <http://qudt.org/schema/qudt/Unit>
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty bmp:hasValue ;
                            owl:someValuesFrom xsd:float
                          ] .


###  https://w3id.org/bmp#hasRelativeGasDiffusivity
bmp:hasRelativeGasDiffusivity rdf:type owl:ObjectProperty ;
                              rdfs:domain bmp:Physical ;
                              rdfs:range bmp:RelativeGasDiffusivity .


###  https://w3id.org/bmp#hasSmokeDevelopment
bmp:hasSmokeDevelopment rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf bmp:hasFireResistance ;
                        rdfs:domain bmp:FireResistance ;
                        rdfs:range bmp:SmokeDevelopment .


###  https://w3id.org/bmp#hasSolarTransmittance
bmp:hasSolarTransmittance rdf:type owl:ObjectProperty ;
                          rdfs:domain bmp:Thermal ;
                          rdfs:range bmp:SolarTransmittance .


###  https://w3id.org/bmp#hasSpecificHeatCapacity
bmp:hasSpecificHeatCapacity rdf:type owl:ObjectProperty ;
                            rdfs:domain bmp:Thermal ;
                            rdfs:range bmp:SpecificHeatCapacity .


###  https://w3id.org/bmp#hasTemperatureCondition
bmp:hasTemperatureCondition rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf bmp:hasThermalConductivity ;
                            rdfs:domain bmp:ThermalConductivity ;
                            rdfs:range bmp:TempCondition .


###  https://w3id.org/bmp#hasThermalConductivity
bmp:hasThermalConductivity rdf:type owl:ObjectProperty ;
                           rdfs:domain bmp:Thermal ;
                           rdfs:range bmp:ThermalConductivity .


###  https://w3id.org/bmp#hasThermalDiffusivity
bmp:hasThermalDiffusivity rdf:type owl:ObjectProperty ;
                          rdfs:domain bmp:Thermal ;
                          rdfs:range bmp:ThermalDiffusivity .


###  https://w3id.org/bmp#hasThermalExpansionCoef
bmp:hasThermalExpansionCoef rdf:type owl:ObjectProperty ;
                            rdfs:domain bmp:Thermal ;
                            rdfs:range bmp:ThermalExpansionCoef .


###  https://w3id.org/bmp#hasThickness
bmp:hasThickness rdf:type owl:ObjectProperty ;
                 rdfs:domain bmp:Layer ,
                             bmp:LayerSet ;
                 rdfs:range [ rdf:type owl:Restriction ;
                              owl:onProperty bmp:hasUnit ;
                              owl:someValuesFrom <http://qudt.org/schema/qudt/Unit>
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty bmp:hasValue ;
                              owl:someValuesFrom xsd:float
                            ] .


###  https://w3id.org/bmp#hasUValue
bmp:hasUValue rdf:type owl:ObjectProperty ;
              rdfs:domain bmp:Layer ,
                          bmp:LayerSet ;
              rdfs:range [ rdf:type owl:Restriction ;
                           owl:onProperty bmp:hasUnit ;
                           owl:someValuesFrom <http://qudt.org/schema/qudt/Unit>
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty bmp:hasValue ;
                           owl:someValuesFrom xsd:float
                         ] .


###  https://w3id.org/bmp#hasVolumetricHeatCapacity
bmp:hasVolumetricHeatCapacity rdf:type owl:ObjectProperty ;
                              rdfs:domain bmp:Thermal ;
                              rdfs:range bmp:VolumetricHeatCapacity .


###  https://w3id.org/bmp#hasWaterVapourDiffusionThickness
bmp:hasWaterVapourDiffusionThickness rdf:type owl:ObjectProperty ;
                                     rdfs:domain bmp:Hygric ;
                                     rdfs:range bmp:WaterVapourDiffusionThickness .


###  https://w3id.org/bmp#hasWaterVapourDiffusivity
bmp:hasWaterVapourDiffusivity rdf:type owl:ObjectProperty ;
