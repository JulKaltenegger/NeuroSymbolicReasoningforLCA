beo:Wire rdf:type owl:Class ;
         rdfs:subClassOf beo:Tendon ;
         rdfs:comment "El tendón es un alambre."@es ,
                      "The tendon is a wire."@en ;
         rdfs:label "Wire"@en ,
                    "Wire"@es .


