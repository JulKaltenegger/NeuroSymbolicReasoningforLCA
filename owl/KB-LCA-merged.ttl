###  https://w3id.org/bot#hasSimple3DModel
bot:hasSimple3DModel rdf:type owl:DatatypeProperty ;
                     rdfs:comment "Collega una istanza di bot:Zone o bot:Element ad un modello 3D codificato come un literal."@it ,
                                  "Forbinder enhver instans af bot:Zone eller bot:Element med en 3D-model beskrevet som en literal."@da ,
                                  "Liittää vyöhykkeen (bot:Zone) tai elementin (bot:Element) sen yksinkertaiseksi arvoksi enkoodattuun 3D-malliin."@fi ,
                                  "Links any bot:Zone or bot:Element to a 3D Model encoded as a literal."@en ,
                                  "Länkar en instans av bot:Zone eller bot:Element till en 3D-modell uttryckt som en RDF literal."@sv ,
                                  "Prepojuje akýkoľvek bot:Zone alebo bot:Element na 3D model definovaný ako literál."@sk ,
                                  "Propojuje jakýkoliv bot:Zone nebo bot:Element na 3D model definovaný jako literál."@cs ,
                                  "Relie tout bot:Zone ou bot:Element à un modèle 3D encodé comme"@fr ,
                                  "Verbindet jede bot:Zone oder bot:Element zu einem 3D Model, dass als Literal codiert ist."@de ,
                                  "Verbindt gelijk welke bot:Zone of bot:Element instantie met een 3D model geëncodeerd in een literal."@nl ,
                                  "Vincula cualquier bot:Zone o bot:Element a un modelo 3D codificado como literal."@es ,
                                  "Vincula qualquer bot:Zone ou bot:Element a um Modelo 3D codificado como um literal."@pt ,
                                  "Vincula qualsevol bot:Zone o bot:Element a un model 3D codificat com literal."@ca ,
                                  "bot:Zone'nin herhangi bir örneğini bağlar ya da bot:Element'i bir literal olarak tanimlanan 3D-model ile bağlar."@tr ,
                                  "رابطه یک عنصر  bot:Zone یا  bot:Elementبا یک مدل سه بعدی که به صورت یک نوشته رمزگذاری شده است."@fa ,
                                  "将任何bot：Zone或bot：Element链接到编码为文本的3D模型。"@zh-cn ;
                     rdfs:isDefinedBy bot: ;
                     rdfs:label "Basit bir 3D modeli var"@tr ,
                                "a modèle 3D simple"@fr ,
                                "ha modello 3D semplice"@it ,
                                "har enkel 3D-modell"@sv ,
                                "har simpel 3D-model"@da ,
                                "has simple 3D model"@en ,
                                "hat einfaches 3D Modell"@de ,
                                "heeft eenvoudig 3D model"@nl ,
                                "má jednoduchý 3D model"@cs ,
                                "má jednoduchý 3D model"@sk ,
                                "omaa yksinkertaisen 3D-mallin"@fi ,
                                "tem modelo 3D simples"@pt ,
                                "tiene modelo 3D simple"@es ,
                                "té un model 3D senzill"@ca ,
                                "مدل سه بعدی ساده دارد"@fa ,
                                "含有简单的3D模型"@zh-cn ;
                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable" ;
                     <https://schema.org/domainIncludes> bot:Element ,
                                                         bot:Zone .


