<https://schema.org/Product> rdf:type owl:Class .


###  https://w3id.org/at#ApartmentHouse
at:ApartmentHouse rdf:type owl:Class ;
                  rdfs:subClassOf at:Residential ;
                  rdfs:comment "A medium to high-rise residential building, A multi-storey apartment building, An apartment block with stacked dwellings." .


###  https://w3id.org/at#Building
at:Building rdf:type owl:Class ;
            owl:equivalentClass bot:Building ,
                                lca:Building .


###  https://w3id.org/at#BuildingArchetype
at:BuildingArchetype rdf:type owl:Class ;
                     owl:equivalentClass [ rdf:type owl:Class ;
                                           owl:oneOf ( at:BuildingArchetype01
                                                       at:BuildingArchetype02
                                                       at:BuildingArchetype03
                                                       at:BuildingArchetype04
                                                       at:BuildingArchetype05
                                                       at:BuildingArchetype06
                                                       at:BuildingArchetype07
                                                       at:BuildingArchetype08
                                                       at:BuildingArchetype09
                                                       at:BuildingArchetype10
                                                       at:BuildingArchetype11
                                                       at:BuildingArchetype12
                                                       at:BuildingArchetype13
                                                       at:BuildingArchetype14
                                                       at:BuildingArchetype15
                                                       at:BuildingArchetype16
                                                       at:BuildingArchetype17
                                                       at:BuildingArchetype18
                                                       at:BuildingArchetype19
                                                       at:BuildingArchetype20
                                                       at:BuildingArchetype21
                                                       at:BuildingArchetype22
                                                       at:BuildingArchetype23
                                                       at:BuildingArchetype24
                                                       at:BuildingArchetype25
                                                       at:BuildingArchetype26
                                                       at:BuildingArchetype27
                                                       at:BuildingArchetype28
                                                       at:BuildingArchetype29
                                                       at:BuildingArchetype30
                                                       at:BuildingArchetype31
                                                       at:BuildingArchetype32
                                                     )
                                         ] ;
                     rdfs:comment "Building archetypes define and utilise core sets of representative construction structures and systems of a building type, formalised as exemplary buildings. BuildingArchetype os a controlled vocabulary (enumeration) containing named individuals (1..n)" .


###  https://w3id.org/at#BuildingElement
at:BuildingElement rdf:type owl:Class ;
                   owl:equivalentClass beo:BuiltElement ,
                                       bot:Element ,
                                       lca:BuildingElement .


###  https://w3id.org/at#BuildingType
at:BuildingType rdf:type owl:Class ;
                rdfs:comment "A building type is a categorical classification of buildings based on the occupation type and other buiding-based characteristics." .


###  https://w3id.org/at#ConstructionPeriod
at:ConstructionPeriod rdf:type owl:Class ;
                      owl:equivalentClass [ rdf:type owl:Class ;
                                            owl:oneOf ( <https://w3id.org/at#1946>
                                                        <https://w3id.org/at#1964>
                                                        <https://w3id.org/at#1974>
                                                        <https://w3id.org/at#1991>
                                                        <https://w3id.org/at#2005>
                                                        <https://w3id.org/at#2014>
                                                        <https://w3id.org/at#2018>
                                                      )
                                          ] ;
                      rdfs:comment """Category: Building Life Cycle / Chronology
What it is / How it is determined: It is the specific timeframe from start to finish where a building is actively being built. It marks the historical era or exact calendar span when construction crews are on-site assembling the structure, lasting from the initial groundbreaking until the building is finished and ready to be lived in.
Description: The specific timeframe from the start of digging the foundation to the final completion where a building is built (ConstructionPeriod).""" .


###  https://w3id.org/at#DetachedHouse
at:DetachedHouse rdf:type owl:Class ;
                 rdfs:subClassOf at:SingleFamilyHouse .


###  https://w3id.org/at#DoorArchetype
at:DoorArchetype rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:oneOf ( at:DoorArchetype01
                                                   at:DoorArchetype02
                                                   at:DoorArchetype03
                                                   at:DoorArchetype04
                                                   at:DoorArchetype05
                                                   at:DoorArchetype06
                                                   at:DoorArchetype07
                                                   at:DoorArchetype08
                                                   at:DoorArchetype09
                                                   at:DoorArchetype10
                                                   at:DoorArchetype11
                                                   at:DoorArchetype12
                                                   at:DoorArchetype13
                                                   at:DoorArchetype14
                                                   at:DoorArchetype15
                                                 )
                                     ] ;
                 rdfs:subClassOf at:ElementArchetype .


###  https://w3id.org/at#ElementArchetype
at:ElementArchetype rdf:type owl:Class ;
                    rdfs:comment "A controlled vocabulary representing the standardized, representative building components (like walls, slabs, or floors) that make up a building archetype (ElementArchetype)." .


###  https://w3id.org/at#FloorArchetype
at:FloorArchetype rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:oneOf ( at:FloorArchetype01
                                                    at:FloorArchetype02
                                                    at:FloorArchetype03
                                                    at:FloorArchetype04
                                                    at:FloorArchetype05
                                                    at:FloorArchetype06
                                                    at:FloorArchetype07
                                                    at:FloorArchetype08
                                                    at:FloorArchetype09
                                                    at:FloorArchetype10
                                                    at:FloorArchetype11
                                                    at:FloorArchetype12
                                                    at:FloorArchetype13
                                                    at:FloorArchetype14
                                                    at:FloorArchetype15
                                                  )
                                      ] ;
                  rdfs:subClassOf at:ElementArchetype ;
                  owl:disjointWith at:WallArchetype .


###  https://w3id.org/at#GalleryHouse
