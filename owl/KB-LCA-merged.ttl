###  https://w3id.org/at#SingleFamilyHouse
at:SingleFamilyHouse rdf:type owl:Class ;
                     rdfs:subClassOf at:Residential ;
                     rdfs:comment "A detached single family house, A semi-detached house with one shared wall, A single residential building not attached on both sides." .


###  https://w3id.org/at#TerraceHouse
at:TerraceHouse rdf:type owl:Class ;
                rdfs:subClassOf at:Residential ;
                rdfs:comment "A long row of identical brick houses sharing side walls, two to three storeys tall, narrow facades, typical Dutch street, A Dutch terrace house in a continuous row of houses, Row houses sharing walls on both sides, Residential buildings forming a long row." .


