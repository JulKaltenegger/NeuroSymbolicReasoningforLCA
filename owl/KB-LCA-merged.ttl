bmp:MaterialCategory rdf:type owl:Class ;
                     owl:disjointWith bmp:MaterialProperty ,
                                      bmp:MaterialType ;
                     rdfs:comment "Material Category class is used to describe material categories in a higher aggregated level."@en ;
                     rdfs:label "MaterialCategory"@en .


###  https://w3id.org/bmp#MaterialProperty
bmp:MaterialProperty rdf:type owl:Class ;
                     owl:disjointWith bmp:MaterialType ;
                     rdfs:comment "A property is an inherent or acquired feature of an item and cannot be part of several property sets."@en ;
                     rdfs:label "MaterialProperty"@en .


###  https://w3id.org/bmp#MaterialType
bmp:MaterialType rdf:type owl:Class ;
                 rdfs:comment "Material Types class is used to describe material typologies and sub typologies in low aggregated level."@en ;
                 rdfs:label "MaterialType"@en .


###  https://w3id.org/bmp#Mechanical
bmp:Mechanical rdf:type owl:Class ;
               rdfs:subClassOf bmp:MaterialProperty ;
               owl:disjointWith bmp:Optical ,
                                bmp:Physical ,
                                bmp:Thermal .


###  https://w3id.org/bmp#MineralFibre
bmp:MineralFibre rdf:type owl:Class ;
                 rdfs:comment "https://www.iso.org/standard/15229.html"@en ,
                              "The mineral fiber category includes insulation and reinforcing materials made by melting down rock, glass, or industrial byproducts and spinning them into fine, wool-like threads. This category covers glass-based fibers (GlassFibres), stone-based insulation (Rockwool), and fibers created from iron-blasting furnace waste (Slagwool)." ;
                 rdfs:label "MineralFibre"@en .


###  https://w3id.org/bmp#MoistureContent
bmp:MoistureContent rdf:type owl:Class ;
                    rdfs:subClassOf bmp:ThermalConductivity .


###  https://w3id.org/bmp#MultiLayer
bmp:MultiLayer rdf:type owl:Class ;
               rdfs:subClassOf bmp:LayerSet .


###  https://w3id.org/bmp#NaturalStone
bmp:NaturalStone rdf:type owl:Class ;
                 rdfs:comment "https://www.iso.org/standard/77077.html"@en ,
                              "The natural stone category includes building materials harvested directly from the earth, formed over millions of years by intense geological heat, pressure, or mineral accumulation. This category covers grainy, compacted sand rock (SandStone), coarse and highly durable speckled volcanic rock (GranitStone), and fine-grained, dark volcanic rock (BasaltStone)." ;
                 rdfs:label "NaturalStone"@en .


###  https://w3id.org/bmp#NonLoadBearing
bmp:NonLoadBearing rdf:type owl:Class ;
                   rdfs:subClassOf bmp:LayerFunction .


###  https://w3id.org/bmp#Opening
bmp:Opening rdf:type owl:Class ;
            rdfs:subClassOf bmp:LayerFunction .


###  https://w3id.org/bmp#Optical
bmp:Optical rdf:type owl:Class ;
            rdfs:subClassOf bmp:MaterialProperty ;
            owl:disjointWith bmp:Physical ,
                             bmp:Thermal .


###  https://w3id.org/bmp#OuterLayer
bmp:OuterLayer rdf:type owl:Class ;
               rdfs:subClassOf bmp:LayerLocation .


###  https://w3id.org/bmp#Physical
bmp:Physical rdf:type owl:Class ;
             rdfs:subClassOf bmp:MaterialProperty ;
             owl:disjointWith bmp:Thermal .


###  https://w3id.org/bmp#Polymer
bmp:Polymer rdf:type owl:Class ;
            rdfs:comment "The polymer category includes versatile, oil-based synthetic plastics engineered for highly effective moisture resistance and heat insulation. This category specifically covers rigid blue or pink foam boards squeezed out through a manufacturing die (extrudedPolystyrene), and standard white beadboard made from pre-foamed beads compressed together into blocks (expandedPolysteren)." ,
                         "synthetic polymerized thermoplastic resin using the Styrene monomer" .


###  https://w3id.org/bmp#Porosity
bmp:Porosity rdf:type owl:Class ;
             rdfs:subClassOf bmp:Physical .


###  https://w3id.org/bmp#PrestressedConcrete
bmp:PrestressedConcrete rdf:type owl:Class ;
                        rdfs:subClassOf bmp:Concrete ;
                        rdfs:comment "https://www.iso.org/standard/41260.html"@en ,
                                     """Material Category: Concrete
What it is made of / How it's made: It is made of high-strength structural concrete cast around high-tensile steel cables. The steel cables are stretched tight by hydraulic jacks, the concrete is poured around them, and once the concrete hardens, the tension on the cables is released, instantly clamping the concrete block tight.
Description: Concrete elements structurally pre-compressed using tensioned steel tendons to handle massive bending loads (PrestressedConcrete).""" ;
                        rdfs:label "PrestressedConcrete"@en .


###  https://w3id.org/bmp#RcValue
bmp:RcValue rdf:type owl:Class ;
            rdfs:subClassOf bmp:LayerProperty .


###  https://w3id.org/bmp#ReinforcedConcrete
bmp:ReinforcedConcrete rdf:type owl:Class ;
                       rdfs:subClassOf bmp:Concrete ;
                       rdfs:comment """Material Category: Concrete / Composite Material
What it is made of / How it's made: It is made by casting fluid concrete—a mixture of cement, water, sand, and gravel aggregates—directly around a structured grid of high-tensile steel bars (rebar) or mesh. As the concrete cures and hardens into an artificial stone, it bonds tightly to the ridges on the steel bars, locking them together into a single structural unit.
Description: A high-strength composite material combining concrete to resist squeezing forces and embedded steel bars to resist pulling or bending forces (ReinforcedConcrete).""" .


###  https://w3id.org/bmp#RelativeGasDiffusivity
bmp:RelativeGasDiffusivity rdf:type owl:Class ;
                           rdfs:subClassOf bmp:Physical .


###  https://w3id.org/bmp#Rockwool
bmp:Rockwool rdf:type owl:Class ;
             rdfs:subClassOf bmp:MineralFibre ;
             rdfs:comment "Material Category: Mineral FibreWhat it is made of / How it's made: It is made from natural volcanic basalt rock and chalk. The stones are melted down into liquid magma at around $1,600^\\circ\\text{C}$ and poured onto high-speed spinning wheels, which fling the liquid out into long, interlocking fuzzy fibers.Description: Stone wool insulation made by melting volcanic rock and spinning it into fireproof, acoustic mats (Rockwool)." ;
             rdfs:label "Rockwool" .


###  https://w3id.org/bmp#SandStone
bmp:SandStone rdf:type owl:Class ;
              rdfs:subClassOf bmp:NaturalStone ;
              rdfs:comment "https://www.iso.org/standard/77077.html"@en ,
                           """Material Category: Natural Stone (Sedimentary Rock)
What it is made of / How it's made: It is made of small, grainy mineral particles—mostly quartz and feldspar. It is formed over vast geological eras as layers of sand accumulate at the bottoms of rivers or deserts, where they are slowly compressed by overlying weight and cemented together by natural silica or calcium deposits.
Description: A grainy, layered sedimentary rock formed by the natural compaction and cementing of sand particles (SandStone).""" ;
              rdfs:label "SandStone"@en .


###  https://w3id.org/bmp#SingleLayer
bmp:SingleLayer rdf:type owl:Class ;
                rdfs:subClassOf bmp:LayerSet .


###  https://w3id.org/bmp#Slagwool
bmp:Slagwool rdf:type owl:Class ;
             rdfs:subClassOf bmp:MineralFibre ;
             rdfs:comment """Material Category: Mineral Fibre

What it is made of / How it's made: It is made from blast-furnace slag, which is the molten mineral waste byproduct left over from smelting iron ore into steel. This liquid waste is collected, reheated, and spun using air pressure or spinning rotors into soft, fibrous wool insulation.

Description: Mineral wool insulation manufactured by spinning molten industrial iron-smelting waste into thermal fibers (Slagwool).""" ;
             rdfs:label "Slagwool" .


###  https://w3id.org/bmp#SmokeDevelopment
bmp:SmokeDevelopment rdf:type owl:Class ;
                     rdfs:subClassOf bmp:FireResistance ;
                     rdfs:label "SmokeDevelopment"@en .


###  https://w3id.org/bmp#SolarTransmittance
bmp:SolarTransmittance rdf:type owl:Class ;
                       rdfs:subClassOf bmp:Thermal .


###  https://w3id.org/bmp#SpecificHeatCapacity
bmp:SpecificHeatCapacity rdf:type owl:Class ;
                         rdfs:subClassOf bmp:Thermal .


###  https://w3id.org/bmp#TempCondition
bmp:TempCondition rdf:type owl:Class ;
                  rdfs:subClassOf bmp:ThermalConductivity .


###  https://w3id.org/bmp#Thermal
bmp:Thermal rdf:type owl:Class ;
            rdfs:subClassOf bmp:MaterialProperty ,
                            bmp:VolumetricHeatCapacity .


###  https://w3id.org/bmp#ThermalConductivity
bmp:ThermalConductivity rdf:type owl:Class ;
                        rdfs:subClassOf bmp:Thermal .


###  https://w3id.org/bmp#ThermalDiffusivity
bmp:ThermalDiffusivity rdf:type owl:Class ;
                       rdfs:subClassOf bmp:Thermal .


###  https://w3id.org/bmp#ThermalExpansionCoef
bmp:ThermalExpansionCoef rdf:type owl:Class ;
                         rdfs:subClassOf bmp:Thermal .


###  https://w3id.org/bmp#Thickness
bmp:Thickness rdf:type owl:Class ;
              rdfs:subClassOf bmp:LayerProperty .


###  https://w3id.org/bmp#UValue
bmp:UValue rdf:type owl:Class ;
           rdfs:subClassOf bmp:LayerProperty .


###  https://w3id.org/bmp#VSG
bmp:VSG rdf:type owl:Class ;
        rdfs:subClassOf bmp:Glass ;
        rdfs:comment """Material Category: Glass / Laminated Safety Glass
What it is made of / How it's made: It is made by creating a \"sandwich\" of two or more sheets of glass (which can be standard float glass or tempered ESG) bound together by an internal layer of tough, sticky plastic film—typically Polyvinyl Butyral (PVB). The layers are pressed together under intense heat and pressure in a specialized oven to make the plastic completely transparent and permanently fuse the panes together.
Description: A laminated safety glass composite consisting of multiple glass sheets bonded together by a sticky plastic interlayer that prevents the pane from falling apart or shattering when broken (VSG).""" .


###  https://w3id.org/bmp#VolumetricHeatCapacity
bmp:VolumetricHeatCapacity rdf:type owl:Class ;
                           rdfs:subClassOf bmp:MaterialProperty ,
                                           bmp:Thermal .


###  https://w3id.org/bmp#WaterVapourDiffusionThickness
bmp:WaterVapourDiffusionThickness rdf:type owl:Class ;
                                  rdfs:subClassOf bmp:Hygric .


###  https://w3id.org/bmp#WaterVapourDiffusivity
bmp:WaterVapourDiffusivity rdf:type owl:Class ;
                           rdfs:subClassOf bmp:Hygric .


###  https://w3id.org/bmp#WaterVapourPermeability
bmp:WaterVapourPermeability rdf:type owl:Class ;
                            rdfs:subClassOf bmp:Hygric .


###  https://w3id.org/bmp#WaterVapourResistanceFactor
bmp:WaterVapourResistanceFactor rdf:type owl:Class ;
                                rdfs:subClassOf bmp:Hygric .


###  https://w3id.org/bmp#WaterVapourSorptionIsotherm
bmp:WaterVapourSorptionIsotherm rdf:type owl:Class ;
                                rdfs:subClassOf bmp:Hygric .


###  https://w3id.org/bmp#WoodHard
bmp:WoodHard rdf:type owl:Class ;
             rdfs:subClassOf bmp:WoodTimber ;
             rdfs:comment "https://www.iso.org/standard/77077.html"@en ,
                          """Material Category: Wood / Timber
What it is made of / How it's made: It is made of complex cellulose fibers derived from angiosperm trees (broad-leaved deciduous trees like Oak, Beech, Maple, and Ash). These trees grow very slowly, resulting in highly packed, tight growth rings with a dense, heavy microscopic pore structure.
Description: High-density, tough timber harvested from slow-growing, broad-leaved deciduous trees (WoodHard).""" ;
             rdfs:label "WoodHard"@en .


###  https://w3id.org/bmp#WoodSoft
bmp:WoodSoft rdf:type owl:Class ;
             rdfs:subClassOf bmp:WoodTimber ;
             rdfs:comment "https://www.iso.org/standard/77077.html"@en ,
                          """Material Category: Wood / Timber
What it is made of / How it's made: It is made of simpler cellulose structures derived from gymnosperm trees (needle-bearing evergreen conifers like Pine, Spruce, Fir, and Cedar). These trees grow rapidly, resulting in wider growth rings and a lighter, more flexible wood matrix.
Description: Lightweight, flexible timber harvested from fast-growing, needle-bearing coniferous evergreen trees (WoodSoft).""" ;
             rdfs:label "WoodSoft"@en .


###  https://w3id.org/bmp#WoodTimber
bmp:WoodTimber rdf:type owl:Class ;
               rdfs:comment "https://www.iso.org/standard/77077.html"@en ,
                            "The wood and timber category includes organic, structural materials harvested from trees, consisting of complex cellulose fibers bound together by a natural glue called lignin. This category covers seasoned lumber dried naturally by open-air circulation (airdrytimber), flexible and fast-growing wood from cone-bearing evergreen trees (woodsoft), and dense, slow-growing wood from broad-leaved deciduous trees (woodhard)." ;
               rdfs:label "Timber"@en ,
                          "Wood"@en .


###  https://w3id.org/bot#Building
bot:Building rdf:type owl:Class ;
             rdfs:subClassOf bot:Zone ;
             owl:disjointWith bot:Site ,
                              bot:Space ,
                              bot:Storey ;
             rdfs:comment "An independent unit of the built environment with a characteristic spatial structure, intended to serve at least one function or user activity [ISO 12006-2:2013]. A bot:Building is a part of the physical world or a virtual world that is inherently both located in this world and having a 3D spatial extent, is contained in a building site, and can contain one or more storeys that are vertically connected."@en ,
                          "Bir yapılı ortamına sahip, ve karakteri mekansal olan ve en az bir funksiyona veya kullanıcı etkinligini desteleyen bir bağımsız parcadir. "@tr ,
                          "Een onafhankelijke entiteit met een ruimtelijke structuur die onderdeel is van de gebouwde omgeving, en bedoeld is om minimaal één functie of gebruikersactiviteit te bedienen [ISO 12006-2:2013]. Een bot:Building is deel van de fysieke wereld of een virtuele wereld dat zowel gelokaliseerd kan worden in deze wereld als een ruimtelijke omvang heeft, is deel van een gebouwsite, en kan één of meerder verdiepingen bevatten die verticaal verbonden zijn."@nl ,
                          "Eine eigenständige Einheit der bebauten Umgebung mit einer charakteristischen räumlichen Struktur. Es besteht die Absicht das es eine Funktion oder Nutzung erlaubt [ISO 12006-2:2013]. Ein bot:Building ist Teil der realen und virtuellen Welt und hat eine räumliche Ausdehnung. Es ist enthalten in einem Grundstück und kann ein oder mehrere Stockwerke enthalten, die vertical miteinander verbunden sind."@de ,
                          "En oberoende enhet i den byggda miljön med en karaktäristisk rumslig struktur som stödjer minst en funktion eller användaraktivitet.  [ISO 12006-2:2013]. En bot:Building är en del av den fysiska världen eller en virtuell värld som har en spatial utsträckning i tre dimensioner, ligger på en plats, och kan ha en eller flera vertikalt förbundna våningar."@sv ,
                          "En uafhængig enhed i det bebyggede miljø med en karakteristisk rumlig struktur, beregnet til at betjene mindst en funktion eller brugeraktivitet [ISO 12006-2: 2013]. En bot:Building er en del af den fysiske verden eller en virtuel verden, der i sagens natur både er lokaliseret i denne verden og har en 3D rumlig afgrænsning, er indeholdt på et byggefelt og kan indeholde en eller flere etager, der er lodret forbundet."@da ,
                          "Nezávislá jednotka v (stavebnom) prostredí či verejnom priestore, s charakteristickou priestorovou štruktúrou a formou, ktorá má slúžiť aspoň pre jednu činnosť alebo funkciu uživateľa [ISO 12006-2:2013]. Bot:Building je súčasťou fyzického alebo virtuálneho sveta, ktorý je neodmyslitelnľ umiestnľný ako vo fyzickom svete, tak má 3D virtuálny priestorový rozsah, je umiestnený na stavenisku (\"Site\") a môže obsahovať jedno alebo viac podlaží, ktoré sú vertikálne prepojené. "@sk ,
                          """Nezávislá jednotka v (stavebním) prostředí či veřejném prostoru, s charakteristickou prostorovou strukturou a formou, která má sloužit alespoň pro jednu činnost nebo funkci uživatele [ISO 12006-2: 2013]. 
Bot:Building je součástí fyzického nebo virtuálního světa, který je neodmyslitelně umístěn jak ve fyzickém světě, tak má 3D virtuální prostorový rozsah, je umístěn na staveništi (\"Site\") a může obsahovat jedno nebo víc podlaží, která jsou vertikálně propojena. """@cs ,
                          "Rakennetun ympäristön itsenäinen osa, jolla on ominainen avaruudellinen rakenne, ja joka on tarkoitettu palvelemaan ainakin yhtä funktiota tai käyttäjäaktiviteettia [ISO 12006-2:2013]. bot:Building on fyysisen tai virtuaalisen maailman osa, joka luonnostaan sekä sijaitsee tässä maailmassa että omaa kolmiulotteiset tilalliset ulottuvuudet, sijaitsee tontilla, ja se voi sisältää yhden tai useamman kerroksen jotka ovat pystysuunnassa yhteydessä."@fi ,
                          """Uma unidade independente do ambiente construído com uma estrutura espacial característica, destinada a servir pelo menos uma função do utilizador [ISO 12006-2:2013].
Um bot:Building é uma parte do mundo físico ou do mundo virtual que está inerentemente localizado neste mundo e que tem uma extensão espacial tridimensional, que está contido num sítio de construção e que contém um ou mais pisos que estão conectados verticalmente."""@pt ,
                          "Un'unità indipendente dell'ambiente costruito con una struttura spaziale caratteristica, destinato a servire almeno una funzione o attività degli utenti [ISO 12006-2:2013]. Un bot:Building è parte del mondo fisico o virtuale che si trova intrinsecamente in questo mondo e ha una estensione spaziale tridimensionale, è contenuto in un sito e può contenere uno o più piani che sono connessi verticalmente."@it ,
                          "Une unité indépendante de l'environnement bâti avec une structure spatiale caractéristique, conçue pour répondre à une fonction ou une activité de l'utilisateur [ISO 12006-2:2013]"@fr ,
                          "Unidad independiente del entorno construido con una estructura espacial característica, destinada a servir al menos una función o actividad del usuario [ISO 12006-2: 2013]. Un bot:Building es tanto una parte del mundo físico o virtual que se encuentra inherentemente situado en este mundo y que tiene una extensión espacial 3D, se encuentra en un emplazamiento de edificación, y puede contener uno o más pisos conectados verticalmente."@es ,
                          "Unitat independent de l’entorn construït amb una estructura espacial característica, destinada a servir almenys una funció o activitat de l’usuari [ISO 12006-2: 2013]. Un bot:Building és tant una part del món físic o virtual que es troba inherentment situat en aquest món i que té una extensió espacial 3D, es troba en un emplaçament d’edificació, i pot contenir un o més pisos connectats verticalment."@ca ,
                          "یک واحد مستقل با ساختار مکانی مشخص از محیط ساخت وساز، که برای ارایه‌ی حداقل یک عملکرد یا فعالیت کاربری در نظرگرفته شده است [ISO 12006-2:2013]. یک bot:Building یک بخش از دنیای فیزیکی یا یک دنیای مجازی است که اساسا در این دنیا قرار دارد و دارای حدود مکانی سه بعدی است، دریک سایت ساختمان قرار گرفته ، و میتواند دربرگیرنده‌ی یک یا چند طبقه باشد که به صورت عمودی به هم متصل شده اند."@fa ,
                          "具有特定空间结构的建筑环境独立单元，旨在服务至少一种功能或用户活动[ISO 12006-2：2013]。 bot:Building是物理或虚拟世界的一部分，其既存在于其中，又具有3D空间范围。bot:Building包含在建筑工地中，并且可以包含一个或多个垂直连接的楼层。"@zh-cn ;
             rdfs:isDefinedBy bot: ;
             rdfs:label "Bina"@tr ,
                        "Budova"@cs ,
                        "Budova"@sk ,
                        "Building"@en ,
                        "Byggnad"@sv ,
                        "Bygning"@da ,
                        "Bâtiment"@fr ,
                        "Edifici"@ca ,
                        "Edificio"@es ,
                        "Edificio"@it ,
                        "Edifício"@pt ,
                        "Gebouw"@nl ,
                        "Gebäude"@de ,
                        "Rakennus"@fi ,
                        "ساختمان"@fa ,
                        "建筑"@zh-cn ;
             <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://w3id.org/bot#Element
bot:Element rdf:type owl:Class ;
            owl:disjointWith bot:Interface ,
                             bot:Zone ;
            rdfs:comment "\"Karakteristik fonksiyonu, şekli veya konumu olan bir binanın bileşeni [ISO 12006-2: 2015, 3.4.7]"@tr ,
                         "Bestanddeel van een gebouwde entiteit met een karakteristieke technische functie, vorm of positie [ISO 12006-2:2015, 3.4.7]"@nl ,
                         "Bestanddel af et bygværk med en karakteristisk funktion, form eller position [ISO 12006-2:2015, 3.4.7]"@da ,
                         "Beståndsdel av ett byggnadsverk med en karaktäristisk teknisk funktion, form eller position [ISO 12006-2:2015, 3.4.7]"@sv ,
                         "Constituant d'un bâtiment remplissant une fonction technique spécifique ou ayant une forme ou une position spécifiques [ISO 12006-2:2015, 3.4.7]"@fr ,
                         "Constituent d'una entitat de construcció amb una funció tècnica característica, forma o posició [ISO 12006-2:2015, 3.4.7]"@ca ,
                         "Constituent of a construction entity with a characteristic technical function, form or position [ISO 12006-2:2015, 3.4.7]"@en ,
                         "Constituinte de uma entidade de construção com uma função técnica característica, forma ou posição [ISO 12006-2:2015, 3.4.7]"@pt ,
                         "Constituyente de una entidad de construcción con una función técnica característica, forma o posición [ISO 12006-2:2015, 3.4.7]"@es ,
                         "Costituente di una entità costruttiva con una funzione tecnica caratteristica, forma o posizione [ISO 12006-2:2015, 3.4.7]"@it ,
                         "Das Bauteil ist im Bauwesen ein einzelnes Teil, ein Element oder eine Komponente, aus denen ein Bauwerk zusammengesetzt wird [ISO 12006-2:2015, 3.4.7]"@de ,
                         "Rakennetun kokonaisuuden osa, jolla on ominainen tekninen funktio, muoto tai sijainti [ISO 12006-2:2015, 3.4.7]"@fi ,
                         "Součást stavební entity s charakteristickou technickou funkcí, formou, nebo umístěním [ISO 12006-2, 3.4.7]"@cs ,
                         "Súčasť stavebnej entity s charakteristickou funkciou, formou, alebo umestením [ISO 12006-2, 3.4.7]"@sk ,
                         "تشکیل دهنده‌ی یک واحد ساخت با عملکرد فنی، فرم و یا موقعیت   مشخص."@fa ,
                         "具有特定技术功能，形式或位置的建筑实体组成部分"@zh-cn ;
            rdfs:isDefinedBy bot: ;
            rdfs:label "Bauteil (Bauwesen)"@de ,
                       "Bina elemanı"@tr ,
                       "Building element"@en ,
                       "Byggdel"@sv ,
                       "Bygningsdel"@da ,
                       "Element de construcció"@ca ,
                       "Elemento arquitectónico"@pt ,
                       "Elemento de construcción"@es ,
                       "Elemento di costruzione"@it ,
                       "Elementti"@fi ,
                       "Gebouwelement"@nl ,
                       "Stavební prvek"@cs ,
                       "Stavebný prvok"@sk ,
                       "Élément d'un bâtiment"@fr ,
                       "المان"@fa ,
                       "构件"@zh-cn ;
            <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://w3id.org/bot#Interface
bot:Interface rdf:type owl:Class ;
              owl:disjointWith bot:Zone ;
              rdfs:comment """A generic concept to qualify the relationship of two or more things in the world, where at least one is a building element or zone. Examples:
    - Qualification of heat transmission between zones through one or more building elements. This includes one-dimensional (surface) heat losses from one zone to another through a single building element, a two dimensional (line) loss from one zone to another through the connection in which the two elements meet or a three dimensional (point) loss from one zone to another through the connection where three elements (typically two walls and a slab) meet. 
    - Connection of an electric device to the electric system of a building. 
    - A door between one room and another."""@en ,
                           "Arayüz, iki bina parçası, iki bölge veya bir bina parçası ile bir bölgenin buluştuğu alandır. İkisi arasındaki bağlantıyı nitelendirmek için kullanılabilir. Bir kullanım durumu, bir bölge ve birkaç bölgeyi kapsayan bir duvar arasındaki ısı transfer alanının niteliği olabilir."@tr ,
                           """Conceito genérico para qualificar a relação entre duas ou mais coisas no mundo, onde pelo menos uma é um elemento de edifício ou uma zona. Exemplos:
- Qualificação de transmissão de calor entre zonas através de um ou mais elementos do edifício. Isto inclui perdas de calor unidimensionais (superfície) de uma zona para outra através de um único elemento do edifício, uma perda bidimensional (linha) de uma zona para outra através da conexão onde os dois elementos se encontram ou uma perda tridimensional (ponto) de uma zona para outra através da conexão onde três elementos se encontram (tipicamente duas paredes e uma laje).
- Conexão de um equipamento eléctrico ao sistema eléctrico de um edifício.
- Uma porta entre dois compartimentos."""@pt ,
                           """Concepte genèric per qualificar la relació de dues o més coses del món, on almenys una d'elles és un element o zona constructiva. 
Exemples:
- Qualificació de la transmissió de calor entre zones a través d’un o més elements d’edificació. Això inclou pèrdues de calor (superficials) unidimensionals d'una zona a una altra mitjançant un element de construcció, una pèrdua bidireccional (en línia) d'una zona a una altra mitjançant la connexió en què es troben els dos elements, o una pèrdua tridimensional (en un punt) d’una zona a una altra mitjançant la connexió on es reuneixen tres elements (normalment dues parets i una llosa).
- Connexió d’un dispositiu elèctric al sistema elèctric d’un edifici.
- Una porta entre una habitació i una altra."""@ca ,
                           """Concepto genérico para calificar la relación de dos o más cosas en el mundo, donde al menos una es un elemento o zona de construcción. 
Ejemplos:
- Calificación de la transmisión de calor entre zonas a través de uno o más elementos de construcción. Esto incluye pérdidas de calor unidimensionales (de superficie) de una zona a otra a través de un único elemento de construcción, una pérdida bidimensional (línea) de una zona a otra a través de la conexión en la que los dos elementos se encuentran, o una pérdida tridimensional de una zona a otra a través de la conexión donde se encuentran tres elementos (típicamente dos paredes y una losa).
- Conexión de un dispositivo eléctrico al sistema eléctrico de un edificio.
- Una puerta entre una habitación y otra."""@es ,
                           """Concetto generico per caratterizzare la relazione fra due o più cose nel mondo, dove almeno una di queste è un elemento di costruzione o una zona. Esempi:
 - La certificazione della trasmissione di calore tra zone attraverso uno o più elementi di costruzione. Questo include la dispersione termica unidimensionale (superficie) da una zona ad un'altra attraverso un singolo elemento di costruzione, un dispersione bidimensionale (linea) da una zona ad un'altra attraverso la connessione dove i due elementi si incontrano, una dispersione tridimensionale (punto) da una zona ad un'altra attraverso la connessione dove tre elementi (tipicamente due pareti e una soletta) si incontrano.
 - Connessione di un dispositivo elettrico con un impianto elettrico di un edificio.
 - Una porta tra una stanza e un'altra."""@it ,
                           """Een generiek concept om een kwalificeerbare relatie te creëren tussen twee of meer dingen uit de wereld, waarbij er minstens één een gebouwelement of zone is. Voorbeelden:
     - kwalificeren van de warmte transmissie tussen gebouw zones doorheen één of meerdere gebouwelementen. Dit omvat ééndimensionele (oppervlakte) warmteverliezen van één zone naar een andere zone doorheen een gebouwelement, tweedimensionele (lijn) verliezen van één zone naar een andere zone doorheen de connectie tussen twee gebouwelementen of driedimensionele (punt) verliezen van één zone naar een andere zone doorheen de connectie tussen drie gebouwelementen (typisch twee muren en een vloer- of dakplaat).
     - Connectie tussen een elektrisch toestel en het elektrisch systeem van een gebouw.
     - Een deur tussen twee ruimtes"""@nl ,
                           "Ein allgemeines Konzept um eine qualifizierte Beziehung zwischen einem oder mehreren Dingen auf der Welt auszudrücken. Hierbei ist wenigstens eines der Dinge ein Bauteil oder eine Zone eines Gebäudes. Beispiele: - Qualifizierung des Wärmeübergangs durch ein oder mehrere Bauteile. Dies umfasst eindimensionale Wärmeübertragung (Fläche) durch ein Bauteil von einer Zone zur nächsten; zweidimensionaler Wärmeübergang (Linie) von einer Zone zur nächsten an der Kontaktstelle, an der sich diese treffen oder dreidimensional (Punkt) von einer zone zur nächsten an der drei Bauteile sich treffen  (typischerweise ist dies der Fall, wenn zwei Wände und die Decke sich treffen); - Verbindung eines elektrischen Geräts mit dem elektrischen Versorgungssystem eines Gebäudes; - Eine Tür zwischen zwei Räumen."@de ,
                           """Et generisk koncept til at kvalificere forholdet mellem to eller flere ting i verden, hvoraf mindst den ene er en bygningsdel eller -zone. Eksempler:
    - Kvalificering af varmeoverførsel mellem zoner gennem en eller flere bygningsdele. Dette inkluderer endimensionelle (flade) varmetab fra en zone til en anden gennem en enkelt bygningsdel, todimensionelle (linie) tab fra en zone til en anden gennem den samling, hvor de to elementer mødes, eller tredimensionelle (punkt) tab fra en zone til en anden gennem samlingen, hvor tre elementer (typisk to vægge og et dæk) mødes.
    - Forbindelsen mellem et elektrisk device og det elektriske system i en bygning.
    - En dør mellem et rum og et andet."""@da ,
                           """Ett generiskt koncept som beskriver relationen mellan två eller flera saker i världen, där åtminstone den ena är ett byggdel eller en zon. Exempelvis: 
- Beskrivning av värmeöverföring mellan zoner genom en eller flera byggdelar. Detta inkluderar endimensionella värmeförluster från en zon till en annan genom en enkel byggdels yta, tvådimensionella förluster från en zon till en annan genom linjen där zonernas respektive byggdelar möts, eller tredimentionella förluster från en zon till en annan genom en punkt där tre byggdelar (vanligtvis två väggar och en platta) möts.
- Kopplingen mellan en elektrisk apparatur och elsystemet i en byggnad.
- En dörr mellan ett rum och ett annat."""@sv ,
                           """Rozhranie je obecný koncept, ktorý definuje vzťah dvoch a viac vecí vo fyzickom svete, kde aspoň jeden z nich je stavebný prvok alebo zóna. 
Príklady:
- koncepcia prenosu tepla mezi zónami prostredníctvom jedného alebo viacero stavebných elementov.  To obshuje plošnú tepelnú výmenu z jednej do druhej zóny cez jeden stavebný element, ďalej to obsahuje tepelnou výmenu lineárnou väzbou, ďalej to obsahuje tepelnú výmenu bodom v/na elemente alebo elementoch (typicky dve steny a podlaha, či strop).
- spojenie elektrického zariadenia do elektrického systému v budove. 
- dvere medzi dvomi miestnosťami. 
"""@sk ,
                           """Rozhraní je obecný koncept který definuje vztah dvou a víc věcí ve fyzickém světě, kde alespoň jeden z nich je stavební element nebo zóna. 
Příklady:
koncepce přenosu tepla mezi zónami prostřednictvím jednoho nebo vícero stavebních elementů. To obsahuje plošnou tepelnou výměnu z jedné do druhé zóna přes jeden stavební objekt, dále to obsahuje tepelnou výměnu lineární vazbou, dále to obsahuje tepelnou výměnu bodem v/na elementu nebo elementech (typicky dvě stěny a podlaha či strop). 
        - spojení elektrického zařízení do elektrického systému v budově.
        - dveře mezi dvěma pokoji
"""@cs ,
                           "Une interface correspond à la surface où se rencontrent a) deux éléments d'un bâtiment, b) deux zones ou  encore c) un élément d'un bâtiment avec une zone. Un cas d'utilisation type est constituée par la qualification de la zone de transmission de chaleur entre une zone et un mur couvrant plusieurs zones."@fr ,
                           """Yleinen konsepti kahden tai useamman asian rajapinnan määrittämiseen, missä ainakin toinen asia on joko elementti tai vyöhyke. Esimerkkejä:
    - Kahden vyöhykkeen välillä yhden tai useamman elementin kautta tapahtuvan lämmönsiirtymisen määrittely. Tämä sisältää yksiulotteiset (pinta) lämpöhäviöt vyöhykeeltä toiselle yhden rakennuselementin kautta, kaksiulotteiset (jana) häviöt yhdeltä vyöhykkeeltä toiselle kahden elementin yhteenliitoskohdissa, tai kolmiulotteiset (piste) häviöt yhdeltä vyöhykkeeltä toiselle kolmen elementin (yleensä kaksi seinää ja taso) yhteenliitospisteessä.
    - Sähkölaitteen liitos rakennuksen sähköjärjestelmään.
    - Ovi kahden huoneen välillä."""@fi ,
                           """یک مفهوم کلی از شرایط رابطه بین دو یا چند چیزدر دنیا، در حالی که حداقل یکی از آنها المان یا منطقه است. مثال:
- شرایط انتقال گرما بین یک منطقه و منطقه دیگر از طریق یک یا چند المان ساختمان. این میتواند شامل انتقال/اتلاف گرمای یک بعدی (سطحی) از یک منطقه به منطقه‌ی دیگر از طریق یک المان ساختمان؛ یا، انتقال/اتلاف گرمای دو بعدی (خطی) از یک منطقه به منطقه‌ی دیگر از طریق اتصال بین دو المان ساختمان؛ و یا، انتقال/اتلاف گرمای سه بعدی (نقطه‌ای) از یک منطقه به منطقه‌ی دیگر از طریق برقراری اتصال بین سه المان ساختمان (معمولا دو دیوار و یک دال) باشد.
- ارتباط یک دستگاه الکتریکی با یک سیستم الکتریکی ساختمان.
- یک در بین یک اتاق و اتاق دیگر.
"""@fa ,
                           """这是一种通用概念，用于限定世界上两个或多个事物之间的关系，其中二者至少一个是建筑构件或区域。 比如说：
 -通过一个或多个建筑构件或建筑区域之间的热传递。 这包括通过单个建筑构件从一个区域到另一区域的一维（表面）热损失，通过两个构件的相接从一个区域到另一区域的二维（线）热损失或通过三个元素（通常是两堵墙和一个平板）的相接从一个区域到另一个区域的三维（点）损耗。
-将电气设备连接到建筑电气系统。
-房间之间的门
"""@zh-cn ;
              rdfs:isDefinedBy bot: ;
              rdfs:label "Arayüzey"@tr ,
                         "Gränssnitt"@sv ,
                         "Grænseflade"@da ,
                         "Interfaccia"@it ,
                         "Interface"@en ,
                         "Interface"@fr ,
                         "Interface"@nl ,
                         "Interface"@pt ,
                         "Interfaz"@es ,
                         "Interfície"@ca ,
                         "Rajapinta"@fi ,
                         """Rozhranie
"""@sk ,
                         "Rozhraní"@cs ,
                         "Schnittstelle"@de ,
                         "رابط"@fa ,
                         "界面"@zh-cn ;
              <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://w3id.org/bot#Site
bot:Site rdf:type owl:Class ;
         rdfs:subClassOf bot:Zone ;
         owl:disjointWith bot:Space ,
                          bot:Storey ;
         rdfs:comment "A part of the physical world or a virtual world that is inherently both located in this world and having a 3D spatial extent. It is intended to contain or contains one or more buildings."@en ,
                      "Bir veya daha fazla bina içeren alan."@tr ,
                      "Een deel van de fysieke wereld of een virtuele wereld dat zowel gelokaliseerd kan worden in deze wereld als een ruimtelijke omvang heeft. Het is bedoeld om één of meerdere gebouwen te bevatten of bevat al één of meerdere gebouwen."@nl ,
                      "Ein Teil der realen oder virtuellen Welt die beide Teil dieser Welt sind und eine räumliche Ausdehnung hat. Es besteht die Absicht, dass es Gebäude enthält, oder es enthält ein oder mehr Gebäude."@de ,
                      "En del af den fysiske verden eller en virtuel verden, der i sagens natur både er lokaliseret i denne verden og har en 3D rumlig afgrænsning. En byggegrund er beregnet til at indeholde, eller indeholder én eller flere bygninger."@da ,
                      "En del av den fysiska världen eller en virtuell värld som har en spatial utsträckning i tre dimensioner. Den är avsedd att innehålla, eller innehåller, en eller flera byggnader."@sv ,
                      "Fyysisen tai virtuaalisen maailman osa, joka luonnostaan sekä sijaitsee tässä maailmassa että omaa kolmiulotteiset tilalliset ulottuvuudet. Sen on tarkoitus sisältää tai se sisältää yhden tai useamman rakennuksen."@fi ,
                      "Stavenisko ako časť fyzického, alebo virtuálneho sveta, ktoré sú neodmysliteľne umiestnené ako vo fyzickom svete tak majúc 3D virtuálny priestorový rozsah. Zámerom staveniska je obsahovať aspoň jednu stavbu, napríklad budovu, či stavebnú konštrukciu."@sk ,
                      """Staveniště jako část fyzického světa nebo virtuálního světa které jsou neodmyslitelně umístěna jak ve fyzickém světě tak majíce 3D virtuální prostorový rozsah. Záměrem staveniště je obsahovat alespoň jednu stavbu, např. budovu či stavební konstrukci.
"""@cs ,
                      "Uma parte do mundo físico ou do mundo virtual que está inerentemente localizada neste mundo e que tem uma extensão espacial tridimensional. Contém ou destina-se a conter um ou mais edifícios."@pt ,
                      "Un site comprend un ou plusieurs bâtiments"@fr ,
                      "Una part del món físic o un món virtual que es troba inherentment ubicada en aquest món i que té una extensió espacial en 3D. Està destinada a contenir un contingut o més edificis."@ca ,
                      "Una parte del mondo fisico o virtuale che si trova intrinsecamente in questo mondo e ha una estensione spaziale tridimensionale. Un sito contiene o è destinato a contenere uno o più edifici."@it ,
                      "Una parte del mundo físico o un mundo virtual que está inherentemente ubicada en este mundo y que tiene una extensión espacial en 3D. Está destinado a contener o contiene uno o más edificios."@es ,
                      """بخشی از دنیای فیزیکی، و یا مجازی که اساساً در دنیا وجود دارد و دارای حدود مکانی سه بعدی است. یک عنصر سایت در برگیرنده‌ی یک یا چند ساختمان است.

"""@fa ,
                      "本质上是存在于物理世界或虚拟世界的一部分，并具有3D空间范围。它旨在包含一个或多个建筑物。"@zh-cn ;
         rdfs:isDefinedBy bot: ;
         rdfs:label "Arsa"@tr ,
                    "Grund"@da ,
                    "Grundstück"@de ,
                    "Lloc"@ca ,
                    "Plats"@sv ,
                    "Site"@en ,
                    "Site"@fr ,
                    "Sitio"@es ,
                    "Sito"@it ,
                    "Stavenisko, stavebný pozemok, stavebná plocha, zastavaná plocha."@sk ,
                    "Staveniště, stavební pozemek, stavební plocha, zastavěná plocha."@cs ,
                    "Sítio"@pt ,
                    "Terrein"@nl ,
                    "Tontti"@fi ,
                    "سایت"@fa ,
                    "地点"@zh-cn ;
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://w3id.org/bot#Space
bot:Space rdf:type owl:Class ;
          rdfs:subClassOf bot:Zone ;
          owl:disjointWith bot:Storey ;
          rdfs:comment "A part of the physical world or a virtual world whose 3D spatial extent is bounded actually or theoretically, and provides for certain functions within the zone it is contained in."@en ,
                       "Een deel van de fysieke wereld of een virtuele wereld waarvan de driedimensionale omvang feitelijk of virtueel begrensd is, en dat bepaalde activiteiten faciliteert in de zone die de ruimte bevat."@nl ,
                       "Ein Teil der realen oder virtuellen Welt, dessen räumliche Ausdehnung tatsächlich oder virtuell begrenzt ist. In der Zone in der es enthalten ist stellt es bestimmte Funktionen bereit."@de ,
                       "En del af den fysiske verden eller en virtuel verden, hvis 3D-rumlige omfang er afgrænset faktisk eller teoretisk, og giver bestemte funktioner inden for den zone, den er indeholdt i."@da ,
                       "En del av den fysiska världen eller en virtuell värld vars spatiala utsträckning i tre dimensioner är faktiskt eller teoretiskt begränsad, och som tillhandahåller vissa funktioner för zonen den är inrymd i."@sv ,
                       "Fiziksel dünyanın veya sanal dünyanın, 3D mekansal kapsamı gerçekte veya teorik olarak tanımlanmış olan ve içinde bulunduğu bölgede belirli fonksiyonları yerine getiren bir kısmıdır."@tr ,
                       "Ohraničený troj-rozmerný rozsah definovaný fyzicky nebo pojmovo [ISO 12006-2 (DIS 2013), 3.4.3]"@sk ,
                       "Ohraničený troj-rozměrný rozsah definovaný fyzicky nebo pojmově [ISO 12006-2 (DIS 2013), 3.4.3]"@cs ,
                       "Osa fyysisestä -tai virtuaalista maailmasta, jonka 3D-tila on rajattu oikeasti tai teoreettisesti ja tarjoaa tiettyjä toimintoja vyöhykkeellä, johon se sisältyy."@fi ,
                       "Uma parte do mundo físico ou de um mundo virtual cuja extensão espacial 3D esteja delimitada de forma efectiva ou teórica, que fornece certas funções dentro da zona em que está contido."@pt ,
                       "Una part de el món físic o d'un món virtual l'extensió espacial tridimensional està limitada física o teòricament, i proveeix certes funcions dins de la zona on està continguda."@ca ,
                       "Una parte del mondo fisico o virtuale il cui spazio 3D è delimitato effettivamente o virtualmente, e fornisce determinate funzioni all'interno della zona in cui è contenuta."@it ,
                       "Una parte del mundo físico o de un mundo virtual cuya extensión espacial tridimensional está limitada física o teóricamente, y provee ciertas funciones dentro de la zona donde está contenida."@es ,
                       "Une partie du monde physique ou virtuel dont l'extension 3D est limitée réellement ou théoriquement, et apporte des fonctions aux zones dans laquelle elle est contenue."@fr ,
                       """بخشی از دنیای فیزیکی، و یا مجازی که وسعت مکانی سه بعدی آن از نظر حقیقی و یا تئوری محدود است، و عملکردهای مشخصی را در منطقه‌ای که در آن قرار گرفته ارائه می دهد.
"""@fa ,
                       "是物理世界或虚拟世界的一部分，其3D空间范围实际上或在理论上受到限制，可在其所包含的区域内提供某些功能。"@zh-cn ;
          rdfs:isDefinedBy bot: ;
          rdfs:label "Espacio"@es ,
                     "Espai"@ca ,
                     "Espaço"@pt ,
                     "Oda"@tr ,
                     "Pièce"@fr ,
                     "Priestor"@sk ,
                     "Prostor"@cs ,
                     "Raum"@de ,
                     "Ruimte"@nl ,
                     "Rum"@da ,
                     "Space"@en ,
                     "Spazio"@it ,
                     "Tila"@fi ,
                     "Utrymme"@sv ,
                     "فضا"@fa ,
                     "空间"@zh-cn ;
          <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://w3id.org/bot#Storey
bot:Storey rdf:type owl:Class ;
           rdfs:subClassOf bot:Zone ;
           rdfs:comment "A part of the physical world or a virtual world that is inherently both located in this world and having a 3D spatial extent. A bot:Storey is contained in one or more buildings, and is intended to contain one or more spaces that are horizontally connected. Storeys of a building are connected by means of vertical connections such as elevators and stairs. A bot:Storey encompasses both zones above and below ground, for example, a building with 21 floors above ground, one ground floor and 3 basements is equal to the sentence: A building has 25 instances of bot:Storey."@en ,
                        "Bir binanın katı"@tr ,
                        "Correspond à un niveau du bâtiment"@fr ,
                        "Een deel van de fysieke wereld of een virtuele wereld dat zowel gelokaliseerd kan worden in deze wereld als een ruimtelijke omvang heeft. Een bot:Storey is deel van één of meerdere gebouwen, en is bedoeld om één of meerdere ruimtes te bevatten die horizontaal geconnecteerd zijn. De verdiepingen van een gebouw zijn verbonden door middel van verticale connecties zoals liften en trappen. Een bot:Storey omvat zowel zones boven als onder de grond, bijvoorbeeld een gebouw met 21 verdiepingen boven de grond, één gelijkvloers en 3 kelderverdiepingen is evenwaardig aan de zin: Een gebouw heeft 25 instanties van bot:Storey."@nl ,
                        "Ein Teil der realen oder virtuellen Welt die beide Teil dieser Welt sind und eine räumliche Ausdehnung hat. Ein bot:Storey ist in einem oder mehreren Gebäuden enthalten und es besteht die Absicht oder es ist der Fall, dass es ein oder mehrere Räume enthält, die horizontal miteinander verbunden sind. Geschosse eines Gebäudes sind vertikal miteinander verbunden, durch zum Beispiel Aufzüge oder Treppen. Ein bot:Storey umfassst zonen die über und unter der Erdoberfläche liegen. Zum Beispiel hat ein Gebäude mit 21 Geschossen über der Erde, ein Erdgeschoss und 3 Kellerstockwerken insgesamt 25 Instanzen von bot:Storey."@de ,
                        "En del af den fysiske verden eller en virtuel verden, der i sagens natur både er lokaliseret i denne verden og har en 3D rumlig afgrænsning. En bot:Storey er indeholdt i en eller flere bygninger og er beregnet til at indeholde et eller flere rum, der er horisontalt forbundet. Etager i en bygning er forbundet ved hjælp af lodrette forbindelser såsom elevatorer og trapper. En bot:Storey omfatter både zoner over og under jorden, for eksempel en bygning med 21 etager over jorden, en stueetage og 3 kældre er lig med sætningen: En bygning har 25 tilfælde af bot:Storey."@da ,
                        "En del av den fysiska världen eller en virtuell värld som har en spatial utsträckning i tre dimensioner. En bot:Storey är inrymd i en eller flera byggnader, och är menad att innehålla ett eller flera utrymmen som är förbundna horisontellt. Sådana våningar i en byggnad är förbundna med hjälp av lodrätta förbindelser såsom hissar och trappor. Bot:Storey kan användas för att beskriva såväl våningar över som under mark; till exempel så har en byggnad med 21 våningar över marken, en entrénvåning, och tre källarvåningar totalt 25 bot:Storey-instanser."@sv ,
                        "Fyysisen tai virtuaalisen maailman osa, joka luonnostaan sekä sijaitsee tässä maailmassa että omaa kolmiulotteiset tilalliset ulottuvuudet. bot:Storey sisältyy yhteen tai useampaan rakennukseen, ja sen tarkoitus on sisältää yksi tai useampi tila jotka ovat vaakasuunnassa yhteydessä. Rakennuksen kerrokset ovat yhteydessä toisiinsa pystysuuntaisilla yhteyksillä, kuten hisseillä ja rappusilla. bot:Storey kattaa vyöhykkeet sekä maan alla että päällä. Esimerkiksi rakennus, jossa on pohjakerros, 21 kerrosta sen yläpuolella, ja 3 kerrosta kellaria, on yhtäläinen seuraavan lauseen kanssa: rakennuksella on 25 bot:Storey instanssia."@fi ,
                        """Uma parte do mundo físico ou do mundo virtual que está inerentemente localizada neste mundo e que tem uma extensão espacial tridimensional. 
Um bot:Storey está contido num ou mais edifícios e está destinado a conter um ou mais espaços que estejam conectados horizontalmente. Os pisos de um edifício estão ligados através de ligações verticais tais como escadas e elevadores.
Um bot:Storey abrange tanto as zonas acima como abaixo do solo; por exemplo, um edifício com 21 andares acima do solo, um piso térreo e três caves pode ser descrito como: um edifício que possui 25 instâncias de bot:Storey."""@pt ,
                        "Una part del món físic o virtual que està inherentment ubicat en aquest món i que té una extensió espacial en 3D. Un bot:Storey està contingut en un o més edificis, i està destinat a contenir un o més espais que estan connectats horitzontalment. Les plantes d'un edifici estan connectades per mitjà de connexions verticals com ascensors i escales. Un bot:Storey abasta les dues zones sobre i sota de terra, per exemple, un edifici amb 21 pisos sobre terra, una planta baixa i 3 soterranis hauria de contenir 25 instàncies de bot:Storey."@ca ,
                        "Una parte del mondo fisico o virtuale che si trova intrinsecamente in questo mondo e ha una estensione spaziale tridimensionale. Un bot:Storey è contenuto in uno o più edifici ed è destinato a contenere uno o più spazi che sono connessi orizzontalmente. I piani di un edificio sono connessi attraverso connessioni verticali come ascensori e scale. Un bot:Storey comprende zone che si trovano sia sopra che sotto il livello del suolo; per esempio, un edificio con un piano terra, ulteriori 21 piani di altezza e 3 piani interrati corrisponde a un edificio con 25 istanze di bot:Storey."@it ,
                        "Una parte del mundo físico o virtual que está inherentemente ubicado en este mundo y que tiene una extensión espacial en 3D. Un bot:Storey está contenido en uno o más edificios, y está destinado a contener uno o más espacios que están conectados horizontalmente. Las plantas de un edificio están conectadas por medio de conexiones verticales como ascensores y escaleras. Un bot:Storey abarca ambas zonas sobre y debajo del suelo, por ejemplo, un edificio con 21 pisos sobre el suelo, una planta baja y 3 sótanos debería contener 25 instancias de bot:Storey."@es ,
                        "Časť fyzického alebo virtuálneho sveta, ktorá je neodmyslitelne umiestnená ako vo fyzickom svete, tak má 3D virtuálny priestorový rozsah. Bot:Storey je obsiahnutý v jednej alebo viacero budovách a má obsahovať jeden alebo viacero priestorov, ktoré sú spojené horizontálne. Podlažia budovy sú spojené zvislými spojmi, ako je napríklad výťahová šachta, alebo schodisko. Bot:Storey zahŕňa ako zóny nad, tak pod úrovňou terénu, napríklad, prehlásenie: budova s 21 nadzemnými podlažiami, prízemím a 3 podzemnými podlažiami má rovnaký význam ako prehlásenie: budova má 25 inštancií bot:Storey."@sk ,
                        "Část fyzického světa nebo virtuálního světa, která je neodmyslitelně umístěna jak ve fyzickém světě tak má 3D virtuální prostorový rozsah. Bot:Storey je obsažen v jedné nebo vícero budovách a má obsahovat jeden nebo vícero prostorů, které jsou spojeny horizontálně. Podlaží budovy jsou spojeny svislými spoji, jako je například výtahová šachta, nebo schodiště. Bot:Storey zahrnuje jak zóny nad tak pod úrovní terénu, například, prohlášení: budova s 21 nadzemními podlažími, jedním přízemím a 3 podzemními podlažími má stejný význam jako prohlášení: budova má 25 instancí bot:Storey."@cs ,
                        """بخشی از دنیای فیزیکی، و یا مجازی که اساساً هم در دنیا وجود دارد و دارای حدود مکانی سه بعدی میباشند. یک bot:Storey در یک یا چند ساختمان قرار میگیرد، و دربرگیرنده‌ی یک یا چند فضا است که به صورت افقی به هم متصل شده اند.
طبقه های یک ساختمان از طریق اتصالات عمودی مانند آسانسور و پله به هم متصل میشوند. یک bot:Storey  هر دو منطقه بالا و زیر زمین را پوشش می‎دهد، برای مثال، یک ساختمان با 21 طبقه بالای زمین، یک طبقه همکف و3 طبفه یک ساختمان با 25 عنصر  bot:Storey  است.
"""@fa ,
                        "本质上是存在于物理世界或虚拟世界的一部分，并具有3D空间范围。bot：Storey包含在一个或多个建筑物中，其旨在包含一个或多个水平连接的空间。 建筑物的楼层通过垂直连接（例如电梯和楼梯）连接。 bot：Storey包含地上和地下两个区域，例如，一栋楼高21层，含有一楼及地下3个地下室的建筑物可以表达为：一栋建筑物有25个bot：Storey实例。"@zh-cn ;
           rdfs:isDefinedBy bot: ;
           rdfs:label "Etage"@da ,
                      "Geschoss (Architektur)"@de ,
                      "Kat"@tr ,
                      "Kerros"@fi ,
                      "Piano di edificio"@it ,
                      "Pis"@ca ,
                      "Piso"@es ,
                      "Piso"@pt ,
                      "Podlažie"@sk ,
                      "Podlaží"@cs ,
                      "Storey"@en ,
                      "Verdieping"@nl ,
                      "Våning"@sv ,
                      "Étage"@fr ,
                      "طبقه"@fa ,
                      "楼层"@zh-cn ;
           <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://w3id.org/bot#Zone
bot:Zone rdf:type owl:Class ;
         rdfs:comment "A part of the physical world or a virtual world that is inherently both located in this world and has a 3D spatial extent; Sub-classes of bot:Zone include bot:Site, bot:Building, bot:Storey, or bot:Space.  An instance of bot:Zone can contain other bot:Zone instances, making it possible to group or subdivide zones. An instance of bot:Zone can be adjacent to or intersecting other bot:Zone instances. Finally, a bot:Zone can instantiate three relations to bot:Element, which are either contained in (bot:containsElement), adjacent to it (bot:adjacentElement) or intersecting (bot:intersectingElement)."@en ,
                      "Een deel van de fysieke wereld of een virtuele wereld dat zowel gelokaliseerd kan worden in deze wereld als een ruimtelijke omvang heeft; subklasses van bot:Zone zijn bot:Site, bot:Building, bot:Storey of bot:Space. Een instantie van bot:Zone kan een ander bot:Zone instantie bevatten, wat gebruikt kan worden om zones te groeperen of op te delen. Een instantie van bot:Zone kan aangrenzend zijn aan of snijdend met een andere bot:Zone instantie. Ten slotte kan een bot:Zone instantie drie relaties hebben met een bot:Element instantie dat het ofwel bevat (bot:containsElement), waar het aangrenzend aan is (bot:adjacentElement) of waarmee het snijdt (bot:intersectingElement)."@nl ,
                      "Ein Teil der realen oder virtuellen Welt die beide Teil dieser Welt sind und eine räumliche Ausdehnung hat; Unterklassen von bot:Zone sind bot:Site, bot:Building, bot:Storey oder bot:Space. Eine Instanz von bot:Zone kann andere Instanzen von bot:Zone enthalten. So ist es möglich Instanzen von bot:Zone zu gruppieren, oder zu unterteilen. Eine Instanz einer bot:Zone kann an eine andere Instanz von bot:Zone angrenzen. Es bestehen drei Möglichkeiten Instanzen von bot:Zone und bot:Element in Beziehung zu setzen. Entweder ein Element ist in einer Zone enthalten (bot:containsElement), es grenzt an eine andere Zone an (bot:adjacentElement) oder es schneidet eine Zone (bot:intersectingElement)."@de ,
                      "En del af den fysiske verden eller en virtuel verden, der i sagens natur både er lokaliseret i denne verden og har en 3D rumlig afgrænsning; Underklasser af bot:Zone inkluderer bot:Site, bot:Building, bot:Storey eller bot:Space. En forekomst af bot:Zone kan indeholde andre bot:Zone-forekomster, hvilket gør det muligt at gruppere eller opdele zoner. En forekomst af bot:Zone kan støde op til andre bot:Zone-forekomster. Endelig kan en bot:Zone-forekomst instantiere to forbindelser til bot:Element, der enten er indeholdt i (bot:containsElement) eller tilstødende dertil (bot:adjacentElement)."@da ,
                      """En del av den fysiska världen eller en virtuell värld som har en spatial utsträckning i tre dimensioner. Underklasser av bot:Zone inkluderar bot:Site, Bot:Building, bot:Storey, och bot:Space. En instans av bot:Zone kan innehålla andra bot:Zone-instanser, vilket gör det möjligt att gruppera eller dela upp zoner. En instans av bot:Zone kan kan ligga angränsande mot andra bot:Zone-instanser. Slutligen kan en instans av bot:Zone ha två relationer till instanser av bot:Element; den kan innehålla dem (bot:containsElement) eller ligga angränsande mot dem (bot:adjacentElement).



"""@sv ,
                      "Fiziksel dünyanın veya sanal dünyanın, doğası gereği, hem bu dünyada bulunan ve hem de 3D bölgesel bir sınırlamaya sahip olan bir parça; Bot:Zone altsınıfları: bot:Site, bot:Building, bot:Storey yada bot:Space. Bir bot:Zone baska bot:Zone-olusumu icerebilir. Bir bot:Zone baska bot:Zone-olusumuyla bitisik olabilir. Son onlarak, bir bot:Zone, bir bot:Element ile iki baglantisi olabilir: ya içerir (bot: includeElement) veya bitisik olur (bot: adjacentElement)."@tr ,
                      "Fyysisen tai virtuaalisen maailman osa, joka luonnostaan sekä sijaitsee tässä maailmassa että omaa kolmiulotteiset tilalliset ulottuvuudet; bot:Zone:n alaluokkia ovat: bot:Site, bot:Building, bot:Storey ja bot:Space. bot:Zone-luokan instanssi voi sisältää muita bot:Zone-instansseja, mikä mahdollistaa vyöhykkeiden ryhmittelyn ja jaon osiin. bot:Zone voi olla muiden bot:Zone-instanssien vieressä tai leikata niitä. Lopuksi, bot:Zone voi instantioida kolmea relaatiota bot:Element:iin, jotka joko sisältyvät siihen (bot:containsElement), ovat sen veiressä (bot:adjacentElement) tai leikkaavat sitä (bot:intersectingElement)."@fi ,
                      "Uma parte do mundo físico ou de um mundo virtual que está inerentemente localizado neste mundo e que possui uma extensão espacial 3D. As Sub-classes de bot:Zone incluem bot:Site, bot:Building, bot:Storey ou bot:Space. Uma instância de bot:Zone pode conter outras instâncias de bot:Zone, tornando possível agrupar ou subdividir zonas. Uma instância de bot:Zone pode ser adjacente a ou intersectar outras instâncias de bot:Zone. Por fim, uma bot:Zone pode instanciar três relações com bot:Element, que ou estão contidas em (bot:containsElement), lhe são adjacentes (bot:adjacentElement) ou as intersecta (bot:intersectingElement)."@pt ,
                      "Una part de el món físic o d'un món virtual que està inherentment ubicat en aquest món i que té una extensió espacial tridimensional; les subclasses de bot:Zone inclouen bot:Site, bot:Building, bot:Storey, o bot:Space. Una instància de bot:Zone pot contenir altres instàncies de bot:Zone, fent possible agrupar o subdividir zones. Una instància de bot:Zone pot ser adjacent a, o intersecar amb altres instàncies de bot:Zone. Finalment, un bot:Zone pot instanciar tres relacions amb bot:Element, que estan continguts en ella (bot:containsElement), són adjacents a ella (bot:adjacentElement), o amb els que interseca (bot:intersectingElement)."@ca ,
                      "Una parte del mondo fisico o virtuale che è intrinsecamente ubicato in questo mondo e che ha un'estensione spaziale tridimensionale; sottoclassi di bot:Zone includono bot:Site, bot:Building, bot:Storey, o bot:Space. Un'istanza di bot:Zone può contenere altre istanze di bot:Zone, rendendo possibile il raggruppamento o la suddivisione di zone. Un'istanza di bot:Zone può essere adiacente o intersecare altre istanze di bot:Zone. Infine, una bot:Zone può istanziare tre relazioni con bot:Element, il quale può essere contenuto (bot:containsElement), essere adiacente (bot:adjacentElement) o intersecare (bot:intersectingElement)."@it ,
                      "Una parte del mundo físico o de un mundo virtual que está inherentemente ubicada en este mundo y que tiene una extensión espacial tridimensional; las subclases de bot:Zone incluyen bot:Site, bot:Building, bot:Storey, o bot:Space. Una instancia de bot:Zone puede contener otras instancias de bot:Zone, lo que permite agrupar o subdividir zonas. Una instancia de bot:Zone puede ser adyacente a, o intersecar con otras instancias de bot:Zone. Finalmente, una bot:Zone puede instanciar tres relaciones con bot:Element, que están contenidas en ella (bot:containsElement), adyacentes a ella (bot:adjacentElement) o con los que interseca (bot:intersectingElement)."@es ,
                      "Une partie du monde physique ou virtuel qui est inhéremment à la fois localisé dans ce monde et a une étendue spatiale 3D; les sous-classes de bot:Zone incluent bot:Site, bot:Building, bot:Storey, ou bot:Space. Une instance de bot:Zone peut contenir d'autres instances de bot:Zone, ce qui permet de grouper ou sub-diviser les zones. Une instance de bot:Zone peut être adjacente ou intersectante à d'autres bot:Zone. Enfin, une bot:Zone peut contenir (bot:containsElement), être adjacent (bot:adjacentElement) ou intersecter (bot:intersectingElement) un bot:Element."@fr ,
                      "Časť fyzického alebo virtuálneho sveta, ktorý je dedične v tomto svete umiestnený a má charakter-rozmer priestoru, ktorý závisí na lokalizácii ako v tomto svete tak vo virtuálnomn svete. Podtriedy bot:Zone zahŕňajú bot:Site, bot:Building, bot:Storey, alebo bot:Space. Inštancia bot:Zone je schopná obsahovať iné bot:Zone inštancie, so schopnosťou zoskupovať alebo pod-rozdeľovať zóny. Inštancia bot:Zone môže byť dotýkajúca sa ďalšej bot:Zone inštancie. Finálne, bot:Zone môže definovať vzťahy k bot:Element, ktoré môžu byť typu zóna obsahuje prvok (bot:containsElement), alebo sa prvok môže zóny dotýkať (bot:adjacentElement)."@sk ,
                      "Část fyzického nebo virtuálního světa, který je dědičně v tomto světe umístěn a má charakter-rozměr prostoru který závisí na lokalizaci jak v reálnem světě, tak ve virtuálním světě. Podtřídy bot:Zone zahrňují bot:Site, bot:Building, bot:Storey, nebo bot:Space. Instance zóny bot:Zone jsou schopny obsahovat další bot:Zone instance se schopností je seskupovat nebo dělit na nižší zóny. Instance bot:Zone může být přiřazena-dotčena k další bot:Zone instanci. Nakonec bot:Zone může definovat dva vztahy elemetntu bot:Element, které jsou buďto obsaženy v zóně (bot:containsElement), nebo se jí dotýkají (bot:adjacentElement)"@cs ,
                      """بخشی از دنیای فیزیکی، و یا مجازی که اساساً در دنیا وجود دارد و دارای حدود مکانی سه بعدی است. زیرکلاس‌های bot:Zone عبارتند از bot:Site، bot:Building، bot:Storey، وbot:Space.
 یک عنصر bot:Zone میتواند دربرگیرنده‌ی عناصر دیگری از جنس bot:Zone  باشد و به این گونه امکان گروه بندی و جداسازی مناطق ختلف بوجود می‌آید. یک عنصر bot:Zone می‌تواند هم‌جوار عناصر دیگری از جنس bot:Zone باشد. در پایان، یک عنصر bot:Zone می‌تواند آغازگر دو نوع رابطه با عناصر bot:Element باشد که شامل دربرگیرندگی (bot:containsElement) وهم‌جواری  (bot:adjacentElement)  است.
"""@fa ,
                      "区域是物理世界或虚拟世界的一部分，既位于现实空间中又可在3D空间中拓展。bot:Zone的子集包括bot:Site, bot:Building, bot:Storey, or bot:Space。bot:Zone实例可包含其他bot:Zone实例，从而可以对区域进行分组或细分。 同时，bot：Zone的实例也可以与其他bot：Zone实例相邻。最后，bot：Zone可以实例化为bot：Element的两个关系，它们可以包含在（bot：containsElement）中，或者与其相邻（bot：adjacentElement）。"@zh-cn ;
         rdfs:isDefinedBy bot: ;
         rdfs:label "Bölge"@tr ,
                    "Vyöhyke"@fi ,
                    "Zon"@sv ,
                    "Zona"@ca ,
                    "Zona"@es ,
                    "Zona"@it ,
                    "Zona"@pt ,
                    "Zone"@da ,
                    "Zone"@de ,
                    "Zone"@en ,
                    "Zone"@fr ,
                    "Zone"@nl ,
                    "Zóna"@cs ,
                    "Zóna"@sk ,
                    "منطقه"@fa ,
                    "区域"@zh-cn ;
         <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  https://w3id.org/lca#A1
lca:A1 rdf:type owl:Class ;
       rdfs:subClassOf lca:LifeCycleStage ;
       rdfs:comment """Material Category: Life Cycle Stage / Product Stage (Cradle)
What it is / How it's measured: It accounts for the raw material extraction and processing. This includes the environmental impacts of mining sand, harvesting wood, or drilling for oil, as well as the energy required to gather these resources.
Description: The life cycle stage tracking the extraction and gathering of raw materials from nature (A1).""" .


###  https://w3id.org/lca#A2
lca:A2 rdf:type owl:Class ;
       rdfs:subClassOf lca:LifeCycleStage ;
       rdfs:comment """Material Category: Life Cycle Stage / Product Stage (Cradle)
What it is / How it's measured: It measures the transportation of raw, extracted materials from the extraction site (like a quarry or forest) to the manufacturing factory floor.
Description: The life cycle stage accounting for the transport of raw ingredients to the manufacturing plant (A2).""" .


###  https://w3id.org/lca#A3
lca:A3 rdf:type owl:Class ;
       rdfs:subClassOf lca:LifeCycleStage ;
       rdfs:comment """Material Category: Life Cycle Stage / Product Stage (Cradle to Gate)
What it is / How it's measured: It covers the actual fabrication of the product inside the factory (e.g., melting sand into glass, baking clay into bricks). It includes factory energy use, water consumption, and manufacturing waste.
Description: The life cycle stage covering the physical manufacturing and packaging of a building material (A3).""" .


###  https://w3id.org/lca#A4
lca:A4 rdf:type owl:Class ;
       rdfs:subClassOf lca:LifeCycleStage ;
       rdfs:comment """Material Category: Life Cycle Stage / Construction Process Stage
What it is / How it's measured: It tracks the transportation of the finished building product from the factory gate to the construction site where the building is being erected.
Description: The life cycle stage measuring the logistics and transport of finished materials to the construction site (A4).""" .


###  https://w3id.org/lca#A5
lca:A5 rdf:type owl:Class ;
       rdfs:subClassOf lca:LifeCycleStage ;
       rdfs:comment """Material Category: Life Cycle Stage / Construction Process Stage
What it is / How it's measured: It calculates the impacts of the physical installation process on-site. This includes crane operation, excavating dirt, on-site energy use, and managing material scrap/waste generated during assembly.
Description: The life cycle stage representing the actual on-site installation and construction activities (A5).""" .


###  https://w3id.org/lca#ADPE
lca:ADPE rdf:type owl:Class ;
         rdfs:subClassOf lca:EnvironmentalIndicator ;
         <http://purl.org/dc/terms/description> """ADPE (Abiotic Depletion Potential for Non-Fossil Resources)
Material Category: Environmental Indicator / Resource Scarcity
What it measures / How it's calculated: It measures the depletion of non-living, non-fossil natural resources, specifically raw chemical elements and minerals (like copper, zinc, iron ore, or limestone). It calculates how much the extraction of a material reduces the global availability of that mineral, using antimony (Sb) equivalents as a baseline reference unit.
Description: An indicator tracking the exhaustion of scarce natural mineral and chemical element resources (ADPE).""" ;
         rdfs:comment "Abiotic Depletion Potential for Elements (ADPE)" .


###  https://w3id.org/lca#ADPF
lca:ADPF rdf:type owl:Class ;
         rdfs:subClassOf lca:EnvironmentalIndicator ;
         <http://purl.org/dc/terms/description> """ADPF (Abiotic Depletion Potential for Fossil Resources)
Material Category: Environmental Indicator / Resource Scarcity
What it measures / How it's calculated: It measures the depletion of non-living energy resources derived from fossil origins, such as crude oil, natural gas, coal, and peat. The calculation sums up the total heating energy content (measured in Megajoules, MJ) of the fossil fuels extracted from nature to power the material's production.
Description: An indicator tracking the permanent consumption of non-renewable fossil energy resources (ADPF).""" ;
         rdfs:comment "Abiotic Depletion Potential of fossil Fuels (ADPF)" .


###  https://w3id.org/lca#AP
lca:AP rdf:type owl:Class ;
       rdfs:subClassOf lca:EnvironmentalIndicator ;
       <http://purl.org/dc/terms/description> "AP (Acidification Potential)Material Category: Environmental Indicator / Air & Soil PollutionWhat it measures / How it's calculated: It measures the potential of airborne pollutants to form acid rain or acidify soils and aquatic ecosystems. It quantifies the release of acidic gases like sulfur dioxide SO2 and nitrogen oxides NO from industrial smokestacks or transport trucks, which react with atmospheric water vapor to lower the pH of ecosystems.Description: An indicator measuring the capacity of chemical emissions to cause acid rain and soil or water acidification (AP)." ;
       rdfs:comment "Acidification Potential (AP)" .


###  https://w3id.org/lca#ActivityType
lca:ActivityType rdf:type owl:Class .


###  https://w3id.org/lca#Aim
lca:Aim rdf:type owl:Class ;
        <http://purl.org/dc/terms/description> """Category: Sustainability Metrics / LCA Configuration
What it is / How it is determined: It is the foundational statement that defines the core purpose, the intended application, and the target audience of a Life Cycle Assessment. Before a single data point is collected, the LCA Aim must be established to dictate why the study is being conducted (e.g., to compare two material archetypes, to achieve green building certification, or to identify carbon hotspots in a design) and who will use the results to make decisions.
Description: The explicitly defined objective and target application that guides the scope, data collection, and decision-making criteria of a Life Cycle Assessment (LCAAim).""" ;
        rdfs:comment "Life-cycle oriented building planning" .


###  https://w3id.org/lca#B1
lca:B1 rdf:type owl:Class ;
       rdfs:subClassOf lca:LifeCycleStage ;
       rdfs:comment """Material Category: Life Cycle Stage / Use Stage
What it is / How it's measured: It tracks any direct environmental emissions released by a material while it is simply existing in the building (such as the release of chemicals or substances from paints, coatings, or plastics into the environment over time).
Description: The life cycle stage tracking the passive environmental release or emissions from materials during normal use (B1).""" .


###  https://w3id.org/lca#B2
lca:B2 rdf:type owl:Class ;
       rdfs:subClassOf lca:LifeCycleStage ;
       rdfs:comment """Material Category: Life Cycle Stage / Use Stage
What it is / How it's measured: It measures the impacts of routine, planned actions required to keep a material clean or functioning as intended (such as energy and water used for cleaning glass facades or washing floor tiles).
Description: The life cycle stage covering the regular cleaning and scheduled maintenance of building components (B2).""" .


###  https://w3id.org/lca#B3
lca:B3 rdf:type owl:Class ;
       rdfs:subClassOf lca:LifeCycleStage ;
       rdfs:comment """Material Category: Life Cycle Stage / Use Stage
What it is / How it's measured: It accounts for the actions taken to fix a broken component to restore it to its original working condition, including the production and transport of small patch-up parts.
Description: The life cycle stage representing the repair of broken or damaged building parts (B3).""" .


###  https://w3id.org/lca#B4
lca:B4 rdf:type owl:Class ;
       rdfs:subClassOf lca:LifeCycleStage ;
       rdfs:comment """Material Category: Life Cycle Stage / Use Stage
What it is / How it's measured: It tracks the full replacement of a material or system that has reached the end of its service life during the building's lifespan (e.g., replacing a roof membrane or window unit after 25 years).
Description: The life cycle stage covering the scheduled, total replacement of worn-out building elements (B4).""" .


###  https://w3id.org/lca#B5
lca:B5 rdf:type owl:Class ;
       rdfs:subClassOf lca:LifeCycleStage ;
       rdfs:comment """Material Category: Life Cycle Stage / Use Stage
What it is / How it's measured: It calculates major, planned modifications or structural changes made to a building to alter its function, extend its lifespan, or modernize its layout.
Description: The life cycle stage representing structural or aesthetic building renovations and modernizations (B5).""" .


###  https://w3id.org/lca#B6
lca:B6 rdf:type owl:Class ;
       rdfs:subClassOf lca:LifeCycleStage ;
       rdfs:comment """Material Category: Life Cycle Stage / Operational Use Stage
What it is / How it's measured: It measures the total amount of grid electricity, gas, oil, or renewable energy consumed by the building's systems (heating, cooling, ventilation, lighting, hot water) during its operational life.
Description: The life cycle stage tracking the energy consumption required to operate the building (B6).""" .


###  https://w3id.org/lca#B7
lca:B7 rdf:type owl:Class ;
       rdfs:subClassOf lca:LifeCycleStage ;
       rdfs:comment """Material Category: Life Cycle Stage / Operational Use Stage
What it is / How it's measured: It measures the volume of clean water consumed by the building's occupants and systems, alongside the environmental cost of treating the resulting wastewater.
Description: The life cycle stage tracking the operational water consumption of the building (B7).""" .


###  https://w3id.org/lca#Building
lca:Building rdf:type owl:Class .


###  https://w3id.org/lca#BuildingElement
lca:BuildingElement rdf:type owl:Class .


###  https://w3id.org/lca#C1
lca:C1 rdf:type owl:Class ;
       rdfs:subClassOf lca:LifeCycleStage ;
       rdfs:comment """Material Category: Life Cycle Stage / End-of-Life Stage
What it is / How it's measured: It covers the physical tear-down, dismantling, or explosive demolition of the building at the end of its useful life, including the energy used by wrecking balls, excavators, and handheld tools.
Description: The life cycle stage representing the deconstruction and demolition of the building (C1).""" .


###  https://w3id.org/lca#C2
lca:C2 rdf:type owl:Class ;
       rdfs:subClassOf lca:LifeCycleStage ;
       rdfs:comment """Material Category: Life Cycle Stage / End-of-Life Stage
What it is / How it's measured: It measures the transportation of the demolished building rubble and structural waste from the deconstruction site to a waste management facility, sorting yard, or landfill.
Description: The life cycle stage tracking the transport of structural waste to disposal or sorting centers (C2).""" .


###  https://w3id.org/lca#C3
lca:C3 rdf:type owl:Class ;
       rdfs:subClassOf lca:LifeCycleStage ;
       rdfs:comment """Material Category: Life Cycle Stage / End-of-Life Stage
What it is / How it's measured: It covers the waste processing activities needed to prepare components for recovery, such as sorting concrete from steel, crushing rubble into aggregate, or shredding wood.
Description: The life cycle stage tracking the waste processing of materials for reuse, recycling, or energy recovery (C3).""" .


###  https://w3id.org/lca#C4
lca:C4 rdf:type owl:Class ;
       rdfs:subClassOf lca:LifeCycleStage ;
       rdfs:comment """Material Category: Life Cycle Stage / End-of-Life Stage
What it is / How it's measured: It calculates the final environmental impacts of dumping non-recyclable waste materials into a landfill or burning them in a standard incinerator without energy capture.
Description: The life cycle stage representing final waste disposal, such as landfilling or incineration (C4).""" .


###  https://w3id.org/lca#D
lca:D rdf:type owl:Class ;
      rdfs:subClassOf lca:LifeCycleStage ;
      rdfs:comment """Material Category: Life Cycle Stage / Benefits and Loads Beyond System Boundary
What it is / How it's measured: It calculates the net environmental credits (benefits) or burdens gained by recycling or reusing the building's materials in future projects (e.g., recycling structural steel into new steel beams, or burning scrap wood to generate municipal electricity, saving raw fossil fuels elsewhere).
Description: The life cycle stage calculating the future environmental benefits, reuse potential, and recycling credits outside the current building's life cycle (D).""" .


###  https://w3id.org/lca#EP
lca:EP rdf:type owl:Class ;
       rdfs:subClassOf lca:EnvironmentalIndicator ;
       <http://purl.org/dc/terms/description> """EP (Eutrophication Potential)
Material Category: Environmental Indicator / Water Pollution
What it measures / How it's calculated: It measures the over-enrichment of aquatic or terrestrial ecosystems with nutrients like nitrogen and phosphorus (often from chemical runoff, wastewater, or manufacturing emissions). This nutrient spike causes massive algae blooms that block sunlight and choke oxygen levels in water bodies, killing fish and destroying biodiversity.
Description: An indicator tracking the risk of ecosystem nutrient over-enrichment and destructive aquatic algae blooms (EP).""" ;
       rdfs:comment "Eutrophication Potential (EP)" .


###  https://w3id.org/lca#EnvironmentalIndicator
lca:EnvironmentalIndicator rdf:type owl:Class ;
                           rdfs:comment "Describes environmental and economic indicators following ISO 11620" .


###  https://w3id.org/lca#FunctionalEquivalent
lca:FunctionalEquivalent rdf:type owl:Class ;
                         <http://purl.org/dc/terms/description> "Category: Sustainability Metrics / LCA ConfigurationWhat it is / How it is determined: It is the quantified, technical baseline that describes exactly what function a material or structural element must perform, how well it must perform it, and for how long. In a Life Cycle Assessment, you cannot fairly compare materials simply by weight or volume (e.g., comparing 1kg, of insulation to1 kg of concrete is meaningless). Instead, the Functional Equivalent establishes a common denominator based on performance—such as \"providing a thermal resistance RcValue of 4 m2K/W for a 1m2 wall area over a reference study period of 50 years.\"Description: The quantified performance requirements for a building component or system used as a reference basis to enable fair environmental comparisons (FunctionalEquivalent)." ;
                         rdfs:comment "Description of the building with regard to its material and time-dependent properties" .


###  https://w3id.org/lca#GWP
lca:GWP rdf:type owl:Class ;
        rdfs:subClassOf lca:EnvironmentalIndicator ;
        <http://purl.org/dc/terms/description> "GWP (Global Warming Potential)Material Category: Environmental Indicator / Climate ImpactWhat it measures / How it's calculated: It measures the total amount of greenhouse gases (like carbon dioxide CO2 methane CH4 and nitrous oxide NO released into the atmosphere during the material's life cycle. It normalizes all these different gases into a single mass unit of carbon dioxide equivalents kgCO2eq  based on how much heat they trap in the atmosphere over a 100-year horizon.Description: An indicator measuring the carbon footprint and overall contribution of a material to global climate change (GWP)." ;
        rdfs:comment "Global Warming Potential (GWP)" .


###  https://w3id.org/lca#Layer
lca:Layer rdf:type owl:Class .


###  https://w3id.org/lca#LayerSet
lca:LayerSet rdf:type owl:Class .


###  https://w3id.org/lca#LifeCycleStage
lca:LifeCycleStage rdf:type owl:Class .


###  https://w3id.org/lca#Material
lca:Material rdf:type owl:Class .


###  https://w3id.org/lca#MaterialIn
lca:MaterialIn rdf:type owl:Class ;
               rdfs:subClassOf lca:ActivityType .


###  https://w3id.org/lca#MaterialLoss
lca:MaterialLoss rdf:type owl:Class ;
                 rdfs:subClassOf lca:ActivityType .


###  https://w3id.org/lca#MaterialOut
lca:MaterialOut rdf:type owl:Class ;
                rdfs:subClassOf lca:ActivityType .


###  https://w3id.org/lca#ODP
lca:ODP rdf:type owl:Class ;
        rdfs:subClassOf lca:EnvironmentalIndicator ;
        <http://purl.org/dc/terms/description> """Material Category: Environmental Indicator / Atmospheric Impact
What it measures / How it's calculated: It measures the potential destruction of the stratospheric ozone layer, which shields the Earth from harmful ultraviolet (UV) radiation. It tracks the release of volatile halogenated hydrocarbons, chlorofluorocarbons (CFCs), and halons, normalizing them against a baseline reference unit of Trichlorofluoromethane (CFC-11) equivalents.
Description: An indicator tracking the emissions of chemical gases that destroy the protective stratospheric ozone layer (ODP).""" ;
        rdfs:comment "Ozone Depletion Potential (ODP)" .


###  https://w3id.org/lca#PEGES
lca:PEGES rdf:type owl:Class ;
          rdfs:subClassOf lca:EnvironmentalIndicator ;
          <http://purl.org/dc/terms/description> """Material Category: Environmental Indicator / Energy Use
What it measures / How it's calculated: It tracks the portion of primary energy consumption derived from secondary (recycled or waste-derived) fuels rather than raw, virgin energy sources. This accounts for things like burning municipal waste, shredded tires, or spent industrial solvents to fire cement kilns instead of burning fresh coal.
Description: An indicator tracking the use of secondary or waste-derived fuels as a primary energy source during manufacturing (PEGES).""" ;
          rdfs:comment "Total primary energy demand (PEges)" .


###  https://w3id.org/lca#PENE
lca:PENE rdf:type owl:Class ;
         rdfs:subClassOf lca:EnvironmentalIndicator ;
         <http://purl.org/dc/terms/description> """Material Category: Environmental Indicator / Energy Use
What it measures / How it's calculated: It measures the total amount of non-renewable primary energy consumed to create and process the material. This represents the total raw energy pulled from fossil or nuclear sources (coal, gas, uranium) before it is converted into electricity or heat, accounting for both fuel used in production and energy embedded inside the material itself as a feedstock.
Description: An indicator calculating the total amount of raw, non-renewable primary energy consumed throughout a material's lifecycle (PENE).""" ;
         rdfs:comment "Non-renewable primary energy demand (PEne)" .


###  https://w3id.org/lca#POCP
lca:POCP rdf:type owl:Class ;
         rdfs:subClassOf lca:EnvironmentalIndicator ;
         <http://purl.org/dc/terms/description> """Material Category: Environmental Indicator / Air Quality
What it measures / How it's calculated: It measures the potential of industrial emissions to produce low-level ground-based ozone, commonly known as photochemical smog. It quantifies the release of Volatile Organic Compounds (VOCs) and carbon monoxide that react chemically with sunlight and nitrogen oxides in the lower atmosphere, creating toxic air pollution that harms human lungs and vegetation.
Description: An indicator measuring the capacity of chemical emissions to create ground-level toxic smog (POCP).""" ;
         rdfs:comment "Photochemical Ozone Creation Potential (POCP)" .


###  https://w3id.org/lca#Process
lca:Process rdf:type owl:Class ;
            rdfs:subClassOf lca:ActivityType .


###  https://w3id.org/lca#ReferenceStudyPeriod
lca:ReferenceStudyPeriod rdf:type owl:Class ;
                         <http://purl.org/dc/terms/description> """Category: Sustainability Metrics / LCA Configuration
What it is / How it is determined: It is the specific, fixed timeframe (typically measured in years) chosen as the baseline for a Life Cycle Assessment. Because different building elements have completely different lifespans—for instance, a concrete foundation might last 100 years while an insulation foam board might last 25—the Reference Study Period establishes a uniform temporal boundary. It dictates how many times shorter-lived materials must be completely replaced (Stage B4) and how much operational energy (Stage B6) is counted, ensuring fair calculations across the entire system.
Description: The fixed, standardized time horizon over which a building's total life cycle environmental impacts are calculated and evaluated (ReferenceStudyPeriod).""" ;
                         rdfs:comment """50 years for office building;
100 years for residential building;""" .


###  https://w3id.org/lca#SystemBoundary
lca:SystemBoundary rdf:type owl:Class ;
                   <http://purl.org/dc/terms/description> """Category: Sustainability Metrics / LCA Configuration
What it is / How it is determined: It is the conceptual line that defines exactly which life cycle stages, physical processes, and geographic locations are included in—or excluded from—a Life Cycle Assessment. Instead of blindly measuring every single molecule affected by a building, the system boundary is a set of strict rules (often dictated by standards like EN 15978) that tells the researcher or software precisely where to stop collecting data. It establishes whether an assessment is a limited analysis or a complete environmental overview.
Description: The structural boundary that defines which life cycle stages and physical processes are included within the scope of an environmental impact assessment (SystemBoundary).""" ;
                   rdfs:comment "Entire buildings, without: -outdoor facilities -selected technical equipment" .


###  https://w3id.org/lca#TransportEoL
lca:TransportEoL rdf:type owl:Class ;
                 rdfs:subClassOf lca:ActivityType .


###  https://w3id.org/lca#TransportToSite
lca:TransportToSite rdf:type owl:Class ;
                    rdfs:subClassOf lca:ActivityType .


###  https://w3id.org/lca#WF
lca:WF rdf:type owl:Class ;
       rdfs:subClassOf lca:EnvironmentalIndicator ;
       <http://purl.org/dc/terms/description> """Material Category: Environmental Indicator / Water Consumption
What it measures / How it's calculated: It measures the total net consumption of fresh water during the material's manufacturing, processing, and supply chain. It evaluates the relative water scarcity in the geographic regions where the water is pulled out of the ground, calculating the potential environmental deprivation caused by using that water instead of leaving it in its natural watershed.
Description: An indicator quantifying the total freshwater consumption and localized water scarcity impacts of a material (WF).""" ;
       rdfs:comment "Water consumption (WF)" .


