#  GOLD / EXPECTED output for EXAMPLE_CASES id = "cavity_wall_materials"
#  Source text (EN): "The wall element is overall 25 cm thick, with a cavity wall, where the
#  in-between layer is an air gap of 5 cm, the outer layer is 5 cm facade made out of bricks,
#  and inner layer is 15 cm load bearing concrete panels."
#
#  This case the pipeline already gets almost right: Cavity topology, 3 layers, correct
#  outer->inner order, correct functions, thicknesses 5+5+15 = 25 = element thickness.
#
#  DELTA vs current pipeline output (ttl/text_examples/cavity_wall_materials.ttl):
#    - layer 03 type was HeavyWeightConcrete. The text only says "concrete panels",
#      so gold asserts category bmp:Concrete and no type.
#    - "bricks" likewise names only category bmp:Brick.
#
#  RULE: if the text only names a category (concrete, brick), emit hasMaterialCategory
#  and omit hasMaterialType. Air carries no bmp:Material.

@prefix at: <https://w3id.org/at#> .
@prefix beo: <https://w3id.org/beo#> .
@prefix bmp: <https://w3id.org/bmp#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix test: <https://namedgraphs.org/test#> .
@prefix unit: <http://qudt.org/2.1/vocab/unit#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

test:wall_cavity_002 a at:ElementArchetype,
        beo:Wall ;
    at:hasDescription "The wall element is overall 25 cm thick, with a cavity wall, where the in-between layer is an air gap of 5 cm, the outer layer is 5 cm facade made out of bricks, and inner layer is 15 cm load bearing concrete panels."@en ;
    bmp:hasLayerSet test:wall_cavity_002_layerset_var1 ;
    bmp:hasThickness [ qudt:unit unit:CentiM ;
            rdf:value "25.0"^^xsd:float ] .

test:wall_cavity_002_layerset_var1 a bmp:Cavity,
        bmp:LayerSet ;
    bmp:hasLayer test:wall_cavity_002_layer_var1_01,
        test:wall_cavity_002_layer_var1_02,
        test:wall_cavity_002_layer_var1_03 ;
    bmp:hasThickness [ qudt:unit unit:CentiM ;
            rdf:value "25.0"^^xsd:float ] .

test:wall_cavity_002_layer_var1_01 a bmp:Layer ;
    bmp:hasLayerFunction bmp:Facade ;
    bmp:hasMaterial test:wall_cavity_002_mat_var1_01 ;
    bmp:hasThickness [ qudt:unit unit:CentiM ;
            rdf:value "5.0"^^xsd:float ] .

test:wall_cavity_002_layer_var1_02 a bmp:Layer ;
    bmp:hasLayerFunction bmp:Air ;
    bmp:hasThickness [ qudt:unit unit:CentiM ;
            rdf:value "5.0"^^xsd:float ] .

test:wall_cavity_002_layer_var1_03 a bmp:Layer ;
    bmp:hasLayerFunction bmp:LoadBearing ;
    bmp:hasMaterial test:wall_cavity_002_mat_var1_03 ;
    bmp:hasThickness [ qudt:unit unit:CentiM ;
            rdf:value "15.0"^^xsd:float ] .

test:wall_cavity_002_mat_var1_01 a bmp:Material ;
    bmp:hasMaterialCategory bmp:Brick .

test:wall_cavity_002_mat_var1_03 a bmp:Material ;
    bmp:hasMaterialCategory bmp:Concrete .
