@prefix at: <https://w3id.org/at#> .
@prefix beo: <https://w3id.org/beo#> .
@prefix bmp: <https://w3id.org/bmp#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix test: <https://namedgraphs.org/test#> .
@prefix unit: <http://qudt.org/2.1/vocab/unit#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

test:floor_renovation_001 a at:ElementArchetype,
        beo:Slab ;
    rdfs:label "Floor 1" ;
    at:hasRenovationStatus test:floor_renovation_001_advanced,
        test:floor_renovation_001_existing,
        test:floor_renovation_001_usual .

test:floor_renovation_001_advanced a at:ElementArchetype,
        beo:Slab ;
    rdfs:label "Floor 1 (Advanced Refurbishment)" ;
    at:hasDescription "add 12 cm insulation below / alternatively: on top of ceiling / combination of both"@en ;
    at:hasRenovationStatus at:MajorRenovation ;
    bmp:hasLayerSet test:floor_renovation_001_advanced_layerset_below,
        test:floor_renovation_001_advanced_layerset_both,
        test:floor_renovation_001_advanced_layerset_top .

test:floor_renovation_001_advanced_layer_insul_below a bmp:Layer ;
    bmp:hasLayerFunction bmp:Insulating ;
    bmp:hasThickness [ qudt:unit unit:CentiM ;
            rdf:value "12.0"^^xsd:float ] .

test:floor_renovation_001_advanced_layer_insul_both_below a bmp:Layer ;
    bmp:hasLayerFunction bmp:Insulating ;
    bmp:hasThickness [ qudt:unit unit:CentiM ;
            rdf:value "12.0"^^xsd:float ] .

test:floor_renovation_001_advanced_layer_insul_both_top a bmp:Layer ;
    bmp:hasLayerFunction bmp:Insulating ;
    bmp:hasThickness [ qudt:unit unit:CentiM ;
            rdf:value "12.0"^^xsd:float ] .

test:floor_renovation_001_advanced_layer_insul_top a bmp:Layer ;
    bmp:hasLayerFunction bmp:Insulating ;
    bmp:hasThickness [ qudt:unit unit:CentiM ;
            rdf:value "12.0"^^xsd:float ] .

test:floor_renovation_001_advanced_layerset_below a bmp:LayerSet,
        bmp:MultiLayer ;
    bmp:hasLayer test:floor_renovation_001_advanced_layer_insul_below,
        test:floor_renovation_001_existing_layer_01,
        test:floor_renovation_001_existing_layer_02 .

test:floor_renovation_001_advanced_layerset_both a bmp:LayerSet,
        bmp:MultiLayer ;
    bmp:hasLayer test:floor_renovation_001_advanced_layer_insul_both_below,
        test:floor_renovation_001_advanced_layer_insul_both_top,
        test:floor_renovation_001_existing_layer_01,
        test:floor_renovation_001_existing_layer_02 .

test:floor_renovation_001_advanced_layerset_top a bmp:LayerSet,
        bmp:MultiLayer ;
    bmp:hasLayer test:floor_renovation_001_advanced_layer_insul_top,
        test:floor_renovation_001_existing_layer_01,
        test:floor_renovation_001_existing_layer_02 .

test:floor_renovation_001_existing a at:ElementArchetype,
        beo:Slab ;
    rdfs:label "Floor 1 (Existing State)" ;
    at:hasDescription "concrete ceiling with 1 cm insulation"@en ;
    at:hasRenovationStatus at:NoRenovation ;
    bmp:hasLayerSet test:floor_renovation_001_existing_layerset .

test:floor_renovation_001_existing_layerset a bmp:LayerSet,
        bmp:MultiLayer ;
    bmp:hasLayer test:floor_renovation_001_existing_layer_01,
        test:floor_renovation_001_existing_layer_02 .

test:floor_renovation_001_existing_mat_01 a bmp:Material ;
    bmp:hasMaterialCategory bmp:Concrete .

test:floor_renovation_001_usual a at:ElementArchetype,
        beo:Slab ;
    rdfs:label "Floor 1 (Usual Refurbishment)" ;
    at:hasDescription "add 8 cm insulation below / alternatively: on top of ceiling (in case of floor renovation)"@en ;
    at:hasRenovationStatus at:MinorRenovation ;
    bmp:hasLayerSet test:floor_renovation_001_usual_layerset_below,
        test:floor_renovation_001_usual_layerset_top .

test:floor_renovation_001_usual_layer_insul_below a bmp:Layer ;
    bmp:hasLayerFunction bmp:Insulating ;
    bmp:hasThickness [ qudt:unit unit:CentiM ;
            rdf:value "8.0"^^xsd:float ] .

test:floor_renovation_001_usual_layer_insul_top a bmp:Layer ;
    bmp:hasLayerFunction bmp:Insulating ;
    bmp:hasThickness [ qudt:unit unit:CentiM ;
            rdf:value "8.0"^^xsd:float ] .

test:floor_renovation_001_usual_layerset_below a bmp:LayerSet,
        bmp:MultiLayer ;
    bmp:hasLayer test:floor_renovation_001_existing_layer_01,
        test:floor_renovation_001_existing_layer_02,
        test:floor_renovation_001_usual_layer_insul_below .

test:floor_renovation_001_usual_layerset_top a bmp:LayerSet,
        bmp:MultiLayer ;
    bmp:hasLayer test:floor_renovation_001_existing_layer_01,
        test:floor_renovation_001_existing_layer_02,
        test:floor_renovation_001_usual_layer_insul_top .

test:floor_renovation_001_existing_layer_01 a bmp:Layer ;
    bmp:hasLayerFunction bmp:LoadBearing ;
    bmp:hasMaterial test:floor_renovation_001_existing_mat_01 .

test:floor_renovation_001_existing_layer_02 a bmp:Layer ;
    bmp:hasLayerFunction bmp:Insulating ;
    bmp:hasThickness [ qudt:unit unit:CentiM ;
            rdf:value "1.0"^^xsd:float ] .

