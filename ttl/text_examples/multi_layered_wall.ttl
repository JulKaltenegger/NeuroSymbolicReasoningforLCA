@prefix at: <https://w3id.org/at#> .
@prefix beo: <https://w3id.org/beo#> .
@prefix bmp: <https://w3id.org/bmp#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix test: <https://namedgraphs.org/test#> .
@prefix unit: <http://qudt.org/2.1/vocab/unit#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

test:wall_multilayer_001 a at:ElementArchetype,
        beo:Wall ;
    at:hasDescription "The wall element is overall 25 cm thick, with a multi-layered wall, where the in-between layer is an air gap of 5 cm, the outer layer is 5 cm facade, and inner layer is 15 cm load bearing."@en ;
    bmp:hasLayerSet test:wall_multilayer_001_layerset_var1 ;
    bmp:hasThickness [ qudt:unit unit:CentiM ;
            rdf:value "25.0"^^xsd:float ] .

test:wall_multilayer_001_layer_var1_01 a bmp:Layer ;
    bmp:hasLayerFunction bmp:Facade ;
    bmp:hasThickness [ qudt:unit unit:CentiM ;
            rdf:value "5.0"^^xsd:float ] .

test:wall_multilayer_001_layer_var1_02 a bmp:Layer ;
    bmp:hasLayerFunction bmp:Air ;
    bmp:hasThickness [ qudt:unit unit:CentiM ;
            rdf:value "5.0"^^xsd:float ] .

test:wall_multilayer_001_layer_var1_03 a bmp:Layer ;
    bmp:hasLayerFunction bmp:LoadBearing ;
    bmp:hasThickness [ qudt:unit unit:CentiM ;
            rdf:value "15.0"^^xsd:float ] .

test:wall_multilayer_001_layerset_var1 a bmp:LayerSet,
        bmp:MultiLayer ;
    bmp:hasLayer test:wall_multilayer_001_layer_var1_01,
        test:wall_multilayer_001_layer_var1_02,
        test:wall_multilayer_001_layer_var1_03 ;
    bmp:hasThickness [ qudt:unit unit:CentiM ;
            rdf:value "25.0"^^xsd:float ] .

